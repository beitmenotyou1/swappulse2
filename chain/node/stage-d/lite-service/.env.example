# Public Stage D canary configuration. Do not add private keys or tokens.
# Replace the second peer with the remote observer's literal Tailscale IPv4.
NODELAB_STAGE_D_LITE_PEERS=http://127.0.0.1:19950,http://100.64.0.2:19961

# Port 18102 deliberately preserves the existing verifier on 18101.
NODELAB_STAGE_D_LITE_PORT=18102

POLL_INTERVAL_MS=5000
PIN_CHECK_INTERVAL_MS=30000
RPC_TIMEOUT_MS=5000
RPC_RATE_LIMIT_PER_MINUTE=120
