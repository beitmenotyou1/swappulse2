# Public/non-secret Stage-D remote observer configuration.
# Copy to .env.remote on the second physical host and edit values there.

MADARA_IMAGE=ghcr.io/madara-alliance/madara@sha256:3c931fa515bbd3760fd5cbc0bcdceb557d3edbd44bec0231cdf52dd6abb475f6
NODELAB_CHAIN_ID=SWAPPULSE_NODELAB_1
NODELAB_CHAIN_NAME=SwapPulse_NodeLab_1
NODELAB_BLOCK_TIME=2s

# Must be the PRIMARY host's private Tailscale gateway endpoint, not a public IP.
NODELAB_SEQUENCER_GATEWAY_URL=http://100.64.0.1:19952

# Bind the remote observer RPC only to THIS remote host's Tailscale IPv4.
NODELAB_REMOTE_TAILSCALE_IP=100.64.0.2
NODELAB_REMOTE_OBSERVER_RPC_PORT=19961

NODELAB_REMOTE_OBSERVER_MEMORY_LIMIT=2g
NODELAB_REMOTE_OBSERVER_CPU_LIMIT=2.0
NODELAB_REMOTE_PIDS_LIMIT=512
NODELAB_REMOTE_STOP_GRACE_PERIOD=330s
