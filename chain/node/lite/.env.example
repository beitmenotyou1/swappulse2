# Add independent community RPCs as they become available.
# With only the canonical RPC configured, the lite node deliberately reports
# trust_mode=single-peer-degraded and independently_verified=false.
# Example:
# SWAPPULSE_RPC_PEERS=https://rpc.swappulse.org/rpc,https://rpc2.example/rpc
SWAPPULSE_RPC_PEERS=

# Keep disabled unless an HTTP peer is addressed by a literal Tailscale
# IPv4 address in 100.64.0.0/10. Other non-local HTTP peers stay blocked.
SWAPPULSE_ALLOW_TAILSCALE_HTTP=0

SWAPPULSE_LITE_PORT=18100
POLL_INTERVAL_MS=15000
PIN_CHECK_INTERVAL_MS=300000
RPC_TIMEOUT_MS=5000
RPC_RATE_LIMIT_PER_MINUTE=120
