# Madara image is resolved into .env.image by prepare-madara-image.sh.
# Do not hand-set :latest in the Compose environment used for benchmark evidence.

# Stage A follows Starknet Sepolia only. This is NOT the SwapPulse network.
MADARA_NETWORK=sepolia

# PublicNode is acceptable for the first hardware-qualification run and keeps
# setup secret-free. For rigorous/repeatable tests, replace this with an
# Ethereum Sepolia endpoint you control. If that URL embeds an API key, keep
# .env private and never commit or paste it into chat.
MADARA_L1_ENDPOINT=https://ethereum-sepolia-rpc.publicnode.com

SWAPPULSE_FULL_LAB_RPC_PORT=19944
