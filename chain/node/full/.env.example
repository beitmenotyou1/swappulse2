# Pin an immutable Madara image/digest before running the lab.
# Do not use :latest for a benchmark/support claim.
MADARA_IMAGE=ghcr.io/madara-alliance/madara@sha256:REPLACE_WITH_VERIFIED_DIGEST

# Phase-A client qualification follows Starknet Sepolia only. This is NOT the
# SwapPulse network. Supply your own Ethereum Sepolia endpoint securely.
MADARA_NETWORK=sepolia
MADARA_L1_ENDPOINT=https://REPLACE_WITH_YOUR_ETHEREUM_SEPOLIA_ENDPOINT

SWAPPULSE_FULL_LAB_RPC_PORT=19944
