# SwapPulse private Starknet testnet host configuration
# Copy this file to .env and replace the CHANGE_ME values locally.
# .env and .env.relay are git-ignored and must never be committed.

# Random integer used to deterministically generate Devnet test accounts.
SWAPPULSE_DEVNET_SEED=CHANGE_ME_TO_A_RANDOM_INTEGER

# Stable public HTTPS URL that points to the read-only RPC gateway.
# Prefer a named Cloudflare Tunnel for persistent testnet use.
SWAPPULSE_PUBLIC_RPC_URL=https://CHANGE_ME.example/rpc

# Optional fixed hostnames for the named Cloudflare Tunnel helper/workflow.
# Example: swappulse-rpc.example.com and swappulse-relay.example.com
SWAPPULSE_RPC_HOSTNAME=CHANGE_ME.example
SWAPPULSE_TX_RELAY_HOSTNAME=CHANGE_ME.example
SWAPPULSE_CLOUDFLARE_TUNNEL_NAME=swappulse-testnet

# Optional local ports. Keep raw RPC on loopback only.
SWAPPULSE_RAW_RPC_PORT=5050
SWAPPULSE_GATEWAY_PORT=8080
SWAPPULSE_TX_RELAY_PORT=8081

# Optional testnet limits/settings.
SWAPPULSE_RPC_RATE_LIMIT=180
SWAPPULSE_INITIAL_BALANCE=1000000000000000000000
SWAPPULSE_RECOVERY_DELAY_SECONDS=172800
