{
  "name": "AppPasswordCode",
  "type": "object",
  "title": "AppPasswordCode",
  "description": "One-time email code stored as a keyed digest. Only backend service-role functions may access it.",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address the code was sent to"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code expires (10 minutes after creation)"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "Whether the code has been used"
    },
    "failed_attempts": {
      "type": "integer",
      "default": 0,
      "description": "Number of failed verification attempts; the code is deleted after 5 failures to prevent brute force"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "reveal",
        "delete"
      ],
      "description": "The management action this code authorizes"
    },
    "target_id": {
      "type": "string",
      "description": "For reveal/delete: the AppPassword id this code is scoped to"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "code_hash": {
      "type": "string",
      "description": "Keyed HMAC-SHA256 digest of the six-digit one-time code; the plaintext is never stored"
    }
  },
  "required": [
    "email",
    "code_hash",
    "expires_at",
    "action"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}