{
  "name": "AppPasswordCode",
  "type": "object",
  "title": "AppPasswordCode",
  "description": "Temporary 6-digit verification code for app-password management actions (create, reveal, delete). Created by send-app-password-code; verified by verify-app-password-code. Admin-only access (service role bypasses RLS).",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address the code was sent to"
    },
    "code": {
      "type": "string",
      "description": "6-digit verification code"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code expires (10 minutes after creation)"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "Whether the code has been used"
    },
    "failed_attempts": {
      "type": "integer",
      "default": 0,
      "description": "Number of failed verification attempts; the code is deleted after 5 failures to prevent brute force"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "reveal",
        "delete"
      ],
      "description": "The management action this code authorizes"
    },
    "target_id": {
      "type": "string",
      "description": "For reveal/delete: the AppPassword id this code is scoped to"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "email",
    "code",
    "expires_at",
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}