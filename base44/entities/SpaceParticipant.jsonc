{
  "name": "SpaceParticipant",
  "type": "object",
  "title": "SpaceParticipant",
  "description": "org.swappulse.spaceParticipant \u2014 a participant in a voice space. Roles: host, co_host, mod, speaker, listener. The host and mods manage the stage: promote listeners to speaker, mute speakers (muted_by_host), assign mod/co_host roles, and remove participants. hand_raised marks a listener requesting to speak. Real-time updates drive the live stage UI.",
  "properties": {
    "space_ref": {
      "type": "string",
      "description": "strongRef at:// URI of the voice space"
    },
    "space_id": {
      "type": "string",
      "description": "Local id of the VoiceSpace for fast lookup"
    },
    "role": {
      "type": "string",
      "enum": [
        "host",
        "co_host",
        "mod",
        "speaker",
        "listener"
      ],
      "default": "listener"
    },
    "hand_raised": {
      "type": "boolean",
      "default": false,
      "description": "Listener requesting to speak"
    },
    "muted": {
      "type": "boolean",
      "default": true,
      "description": "Self-mute state (participant toggled their own mic off)"
    },
    "muted_by_host": {
      "type": "boolean",
      "default": false,
      "description": "Host/mod muted this participant's mic; their audio is not sent to the mesh while true."
    },
    "joined_at": {
      "type": "string",
      "format": "date-time"
    },
    "left_at": {
      "type": "string",
      "format": "date-time"
    },
    "participant_name": {
      "type": "string"
    },
    "participant_handle": {
      "type": "string"
    },
    "participant_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the participant (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.spaceParticipant)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the record to the participant's signing key (simulated)"
    }
  },
  "required": [
    "space_ref",
    "space_id",
    "role",
    "joined_at"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}