{
  "name": "ContentReport",
  "type": "object",
  "title": "ContentReport",
  "description": "org.swappulse.contentReport \u2014 a user-submitted report flagging content (post, listing, message, or profile) for moderator review. Each report feeds into the AI moderation learning loop as AgentFeedback so the agent learns what the community considers reportable.",
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "post",
        "trade_listing",
        "trade_message",
        "profile"
      ],
      "description": "The type of content being reported"
    },
    "content_id": {
      "type": "string",
      "description": "Entity id of the reported content"
    },
    "content_preview": {
      "type": "string",
      "maxLength": 500,
      "description": "Snippet of the reported content for moderator context"
    },
    "author_handle": {
      "type": "string",
      "description": "Handle of the reported content's author"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "scam",
        "harassment",
        "nsfw",
        "off_topic",
        "misgraded",
        "impersonation",
        "other"
      ],
      "description": "The category of report"
    },
    "details": {
      "type": "string",
      "maxLength": 1000,
      "description": "Free-text explanation from the reporter"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "dismissed",
        "escalated"
      ],
      "default": "pending"
    },
    "resolved_by": {
      "type": "string",
      "description": "User id of the moderator who resolved the report"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolution_notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "content_type",
    "content_id",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}