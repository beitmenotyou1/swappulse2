{
  "name": "ContentReport",
  "type": "object",
  "title": "ContentReport",
  "description": "org.swappulse.contentReport — a user-submitted moderation report. Reporters provide the reason, details and optional evidence. Direct-message bodies remain end-to-end encrypted; SwapPulse does not routinely decrypt or escrow new DM plaintext for moderation.",
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "post",
        "trade_listing",
        "trade_message",
        "profile",
        "direct_message"
      ],
      "description": "The type of content being reported"
    },
    "content_id": {
      "type": "string",
      "description": "Entity id of the reported content"
    },
    "content_preview": {
      "type": "string",
      "maxLength": 500,
      "description": "Snippet of the reported content for moderator context"
    },
    "author_handle": {
      "type": "string",
      "description": "Handle of the reported content's author"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "scam",
        "harassment",
        "nsfw",
        "off_topic",
        "misgraded",
        "impersonation",
        "other"
      ],
      "description": "The category of report"
    },
    "details": {
      "type": "string",
      "maxLength": 1000,
      "description": "Free-text explanation from the reporter"
    },
    "evidence_urls": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string"
      },
      "description": "URLs of uploaded evidence files (screenshots, images) supporting the report"
    },
    "reported_message_plaintext": {
      "type": "string",
      "maxLength": 4000,
      "description": "Legacy field retained for historical reports only. New DM reports do not populate it. Readable and writable only by moderation staff.",
      "rls": {
        "read": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "moderator"
              }
            }
          ]
        },
        "create": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "moderator"
              }
            }
          ]
        },
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "moderator"
              }
            }
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "dismissed",
        "escalated"
      ],
      "default": "pending",
      "rls": {
        "create": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "moderator"
              }
            }
          ]
        },
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "moderator"
              }
            }
          ]
        }
      }
    },
    "resolved_by": {
      "type": "string",
      "description": "User id of the moderator who resolved the report",
      "rls": {
        "create": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "moderator"
              }
            }
          ]
        },
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "moderator"
              }
            }
          ]
        }
      }
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "create": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "moderator"
              }
            }
          ]
        },
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "moderator"
              }
            }
          ]
        }
      }
    },
    "resolution_notes": {
      "type": "string",
      "maxLength": 1000,
      "rls": {
        "create": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "moderator"
              }
            }
          ]
        },
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "moderator"
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "content_type",
    "content_id",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
