{
  "name": "WebAuthnCredential",
  "type": "object",
  "title": "WebAuthnCredential",
  "description": "Registered WebAuthn/U2F credential metadata. Owners may read their own credentials; creation, mutation and deletion are backend-only so browser clients cannot bypass attestation verification or step-up security.",
  "properties": {
    "credential_id": {
      "type": "string",
      "description": "Base64url-encoded credential ID"
    },
    "public_key": {
      "type": "string",
      "description": "Base64url-encoded COSE public key"
    },
    "counter": {
      "type": "integer",
      "default": 0,
      "description": "Authenticator signature counter"
    },
    "transports": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "usb",
          "nfc",
          "ble",
          "internal",
          "hybrid",
          "smart-card"
        ]
      }
    },
    "label": {
      "type": "string",
      "maxLength": 60
    },
    "user_id": {
      "type": "string",
      "description": "Owning Base44 user id"
    },
    "email": {
      "type": "string",
      "description": "Denormalised owner email for login lookup"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "credential_id",
    "public_key",
    "user_id",
    "email"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}