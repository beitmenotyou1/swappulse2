{
  "name": "WebAuthnCredential",
  "type": "object",
  "title": "WebAuthnCredential",
  "description": "A registered WebAuthn/U2F security key credential for a user. Owner-readable by explicit user_id; all mutation is backend-only so registration attestation and step-up checks cannot be bypassed with direct entity writes.",
  "properties": {
    "credential_id": {
      "type": "string",
      "description": "Base64url-encoded credential ID (unique per authenticator)"
    },
    "public_key": {
      "type": "string",
      "description": "Base64url-encoded COSE-encoded public key for verifying assertions"
    },
    "counter": {
      "type": "integer",
      "default": 0,
      "description": "Signature counter from the last assertion; used for replay detection (monotonic increase check)"
    },
    "transports": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "usb",
          "nfc",
          "ble",
          "internal",
          "hybrid",
          "smart-card"
        ]
      },
      "description": "Authenticator transports hints returned during registration"
    },
    "label": {
      "type": "string",
      "maxLength": 60,
      "description": "User-friendly name for this security key (e.g. 'YubiKey 5C', 'Touch ID')"
    },
    "user_id": {
      "type": "string",
      "description": "User ID this credential belongs to (for service-role lookup during auth)"
    },
    "email": {
      "type": "string",
      "description": "User email (denormalized for service-role lookup during unauthenticated auth)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this credential was registered"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "credential_id",
    "public_key",
    "user_id",
    "email"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}