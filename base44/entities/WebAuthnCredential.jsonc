{
  "name": "WebAuthnCredential",
  "type": "object",
  "title": "WebAuthnCredential",
  "description": "A registered WebAuthn/U2F security key for a user's second-factor authentication. Stores the credential ID, public key (as JWK JSON for Web Crypto verification), signature counter for clone detection, and a user-friendly label. Owner-only access via RLS.",
  "properties": {
    "credential_id": {
      "type": "string",
      "description": "Base64url-encoded credential ID from the authenticator"
    },
    "public_key_jwk": {
      "type": "string",
      "description": "JSON-stringified JWK public key for Web Crypto API signature verification"
    },
    "counter": {
      "type": "integer",
      "default": 0,
      "description": "Signature counter for clone detection; must increase on each use"
    },
    "label": {
      "type": "string",
      "maxLength": 60,
      "description": "User-friendly name for this security key (e.g. 'YubiKey', 'Touch ID')"
    },
    "transports": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "usb",
          "nfc",
          "ble",
          "internal",
          "hybrid"
        ]
      },
      "description": "Authenticator transport hints for the authentication UI"
    },
    "algorithm": {
      "type": "integer",
      "description": "COSE algorithm identifier (-7 for ES256, -257 for RS256)"
    }
  },
  "required": [
    "credential_id",
    "public_key_jwk",
    "algorithm"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}