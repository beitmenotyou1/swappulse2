{
  "name": "Journal",
  "type": "object",
  "title": "Journal",
  "description": "org.swappulse.journal \u2014 a collector's published journal entry, mirrored to AT Protocol as a real org.swappulse.journal record so journals are portable and discoverable across instances. Additionally published as a site.standard.document for interoperable long-form discovery.",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "subtitle": {
      "type": "string",
      "maxLength": 300
    },
    "body": {
      "type": "string",
      "maxLength": 50000,
      "description": "Markdown-formatted journal content"
    },
    "cover_image_uri": {
      "type": "string",
      "description": "Cover image blob URI"
    },
    "embedded_card_uris": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "description": "at:// URI of a card referenced in the journal"
      }
    },
    "embedded_stats": {
      "type": "object",
      "description": "Frozen collection stats snapshot at publication time",
      "properties": {
        "total_collection_value": {
          "type": "number"
        },
        "set_completion_percent": {
          "type": "number"
        },
        "total_cards": {
          "type": "integer"
        },
        "rarest_card_uri": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 30
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "followers",
        "private"
      ],
      "default": "public"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "like_count": {
      "type": "integer",
      "default": 0
    },
    "standard_doc_uri": {
      "type": "string",
      "description": "at:// URI of the site.standard.document record (interoperable long-form metadata wrapper). Empty until the standard.site document is published."
    },
    "standard_pub_uri": {
      "type": "string",
      "description": "at:// URI of the author's per-author site.standard.publication record"
    },
    "recommend_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of site.standard.graph.recommend records pointing at this journal's standard.site document"
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the journal author"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.journal)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the journal to the author's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the journal has been mirrored to the AT Protocol PDS as a real org.swappulse.journal record"
    }
  },
  "required": [
    "title",
    "body",
    "visibility"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}