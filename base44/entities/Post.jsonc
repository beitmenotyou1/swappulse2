{
  "name": "Post",
  "type": "object",
  "title": "Post",
  "properties": {
    "content": {
      "type": "string",
      "description": "The text body of the post",
      "maxLength": 500
    },
    "post_type": {
      "type": "string",
      "enum": [
        "text",
        "pack_opening",
        "trade",
        "showcase"
      ],
      "default": "text"
    },
    "hashtags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string"
      },
      "description": "Raw user-typed hashtags (original casing, #-stripped)"
    },
    "canonical_tags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string"
      },
      "description": "Normalised hashtags (lowercased, trimmed, deduped) for discovery"
    },
    "moderation_labels": {
      "type": "array",
      "description": "Hashtag abuse / moderation labels applied by the labeler at creation time",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "inform",
              "warn",
              "escalate"
            ]
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "dismissed",
        "escalated"
      ],
      "description": "Moderator review state; set to 'pending' when labels are first applied"
    },
    "moderation_notes": {
      "type": "string",
      "description": "Optional moderator notes from the review decision"
    },
    "moderated_by": {
      "type": "string",
      "description": "User id of the moderator who resolved the flag"
    },
    "moderated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the moderator decision was recorded"
    },
    "card_id": {
      "type": "string",
      "description": "TCGDex card id when a card is attached"
    },
    "card_name": {
      "type": "string"
    },
    "card_image": {
      "type": "string"
    },
    "card_rarity": {
      "type": "string"
    },
    "set_name": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "likes": {
      "type": "integer",
      "default": 0
    },
    "reposts": {
      "type": "integer",
      "default": 0
    },
    "replies": {
      "type": "integer",
      "default": 0
    },
    "reply_to": {
      "type": "string",
      "description": "Post id this is a reply to"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the author (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the record to the author's signing key (simulated)"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}