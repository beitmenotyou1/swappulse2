{
  "name": "Post",
  "type": "object",
  "title": "Post",
  "properties": {
    "content": {
      "type": "string",
      "description": "The text body of the post",
      "maxLength": 500
    },
    "post_type": {
      "type": "string",
      "enum": [
        "text",
        "pack_opening",
        "trade",
        "showcase"
      ],
      "default": "text"
    },
    "hashtags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string"
      },
      "description": "Raw user-typed hashtags (original casing, #-stripped)"
    },
    "canonical_tags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string"
      },
      "description": "Normalised hashtags (lowercased, trimmed, deduped) for discovery"
    },
    "card_id": {
      "type": "string",
      "description": "TCGDex card id when a card is attached"
    },
    "card_name": {
      "type": "string"
    },
    "card_image": {
      "type": "string"
    },
    "card_rarity": {
      "type": "string"
    },
    "set_name": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "likes": {
      "type": "integer",
      "default": 0
    },
    "reposts": {
      "type": "integer",
      "default": 0
    },
    "replies": {
      "type": "integer",
      "default": 0
    },
    "reply_to": {
      "type": "string",
      "description": "Post id this is a reply to"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the author (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the record to the author's signing key (simulated)"
    }
  },
  "required": [
    "content"
  ]
}