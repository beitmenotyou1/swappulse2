{
  "name": "Post",
  "type": "object",
  "title": "Post",
  "properties": {
    "content": {
      "type": "string",
      "description": "The text body of the post",
      "maxLength": 500
    },
    "post_type": {
      "type": "string",
      "enum": [
        "text",
        "pack_opening",
        "trade",
        "showcase"
      ],
      "default": "text"
    },
    "post_category": {
      "type": "string",
      "enum": [
        "general",
        "top_tier_trade",
        "grading_advice",
        "local_meetup",
        "market_analysis",
        "collection_help"
      ],
      "default": "general",
      "description": "Structured category tag for the post, letting users label content for filtering in the main feed (e.g. Top Tier Trade, Grading Advice, Local Meetup). Independent of post_type; 'general' is the default for uncategorised posts."
    },
    "visibility_scope": {
      "type": "string",
      "enum": [
        "public",
        "followers",
        "mentioned"
      ],
      "default": "public",
      "description": "Who can see this post. 'public' (default) is visible to everyone and federates publicly. 'followers' is visible only to accounts who follow the author. 'mentioned' is visible only to accounts whose DIDs are in mentioned_dids. Enforced on local feed and detail reads; mirrored to the PDS as an app.bsky.feed.postgate record so remote Bluesky clients enforce it. Independent of reply_policy (who can reply)."
    },
    "mentioned_dids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DIDs of accounts mentioned in the post. Populated from @handles in the content at compose time. Used as the viewer allowlist when visibility_scope is 'mentioned'."
    },
    "hashtags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string"
      },
      "description": "Raw user-typed hashtags (original casing, #-stripped)"
    },
    "canonical_tags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string"
      },
      "description": "Normalised hashtags (lowercased, trimmed, deduped) for discovery"
    },
    "quote_of_id": {
      "type": "string",
      "description": "Local id of the Post this post quotes (commentary layered over an embedded original). Populated at compose time so the QuotedPostCard embed renders before the PDS bridge completes."
    },
    "quote_ref": {
      "type": "string",
      "description": "at:// URI of the quoted post (the embedded original). For local quotes this is the target's at_uri; for quotes of external posts it is the remote at:// URI. Used to render the embed and to bridge app.bsky.embed.record."
    },
    "embed_images": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": "string",
            "maxLength": 500,
            "description": "Accessibility alt text for the image"
          }
        }
      },
      "description": "Up to 4 images attached to the post, each with optional alt text. Populated by compose (UploadFile), backfill, and ingest from Bluesky app.bsky.embed.images. Legacy records may store plain URL strings; the renderer normalises both forms."
    },
    "embed_video": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Original video URL (YouTube/TikTok/etc.)"
        },
        "alt_text": {
          "type": "string",
          "maxLength": 500,
          "description": "Accessibility alt text for the video"
        },
        "platform": {
          "type": "string",
          "enum": [
            "youtube",
            "tiktok",
            "vimeo",
            "twitch",
            "dailymotion",
            "spotify",
            "instagram",
            "other"
          ]
        },
        "thumbnail": {
          "type": "string",
          "description": "Optional thumbnail URL for the video"
        }
      },
      "description": "External video link that auto-embeds as an inline player on SwapPulse. Bridged to Bluesky as an app.bsky.embed.external link card (external videos cannot be uploaded as PDS blobs)."
    },
    "embed_external": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "thumb": {
          "type": "string"
        },
        "site_name": {
          "type": "string"
        }
      },
      "description": "External link card from Bluesky app.bsky.embed.external or from server-side OpenGraph parsing. Populated by compose (fetch-link-preview), backfill, and ingest for bridged posts."
    },
    "moderation_labels": {
      "type": "array",
      "description": "Hashtag abuse / moderation labels applied by the labeler at creation time",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "inform",
              "warn",
              "escalate"
            ]
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "ai_generated": {
            "type": "boolean",
            "default": false,
            "description": "True if this label was applied by the AI moderation agent"
          },
          "recommended_action": {
            "type": "string",
            "enum": [
              "hide",
              "warn",
              "surface_for_review",
              "allow"
            ],
            "description": "AI-recommended moderation action"
          }
        }
      }
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "dismissed",
        "escalated"
      ],
      "description": "Moderator review state; set to 'pending' when labels are first applied"
    },
    "moderation_notes": {
      "type": "string",
      "description": "Optional moderator notes from the review decision"
    },
    "moderated_by": {
      "type": "string",
      "description": "User id of the moderator who resolved the flag"
    },
    "moderated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the moderator decision was recorded"
    },
    "card_id": {
      "type": "string",
      "description": "TCGDex card id when a card is attached"
    },
    "card_name": {
      "type": "string"
    },
    "card_image": {
      "type": "string"
    },
    "card_alt_text": {
      "type": "string",
      "maxLength": 300,
      "description": "User-authored alt text describing the attached card image for screen readers and accessibility. Falls back to card_name when empty."
    },
    "card_rarity": {
      "type": "string"
    },
    "set_name": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "original_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Original creation timestamp from the source platform (Bluesky val.createdAt). Used for display so imported posts show their original timestamp, not the import time. Falls back to created_date when empty."
    },
    "likes": {
      "type": "integer",
      "default": 0
    },
    "reposts": {
      "type": "integer",
      "default": 0
    },
    "replies": {
      "type": "integer",
      "default": 0
    },
    "reply_policy": {
      "type": "string",
      "enum": [
        "everybody",
        "nobody",
        "mentioned",
        "followers"
      ],
      "default": "everybody",
      "description": "Who can reply to this post (postGate). Mirrored to the PDS as an.bsky.feed.postgate record. Enforced client-side on createReply; the bridged postgate is the source of truth for remote enforcement."
    },
    "reply_to": {
      "type": "string",
      "description": "Post id this is a reply to"
    },
    "parent_uri": {
      "type": "string",
      "description": "at:// URI of the parent post (for federated reply threading)"
    },
    "parent_cid": {
      "type": "string",
      "description": "CID of the parent post (for federated reply threading)"
    },
    "root_uri": {
      "type": "string",
      "description": "at:// URI of the root post in the reply thread (for federated reply threading)"
    },
    "root_cid": {
      "type": "string",
      "description": "CID of the root post in the reply thread (for federated reply threading)"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the author (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the record to the author's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the post has been mirrored to the AT Protocol PDS as a real app.bsky.feed.post. Interactions (likes/reposts) only bridge when this is true, so they reference a real record instead of creating orphaned PDS entries."
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}