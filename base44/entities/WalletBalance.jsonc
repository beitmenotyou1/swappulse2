{
  "name": "WalletBalance",
  "type": "object",
  "title": "WalletBalance",
  "description": "org.swappulse.walletBalance \u2014 a collector's dual-currency wallet balance tracking fiat_cents (from Stripe top-ups, pre-conversion) and usdc_wei (USDC on Polygon, post-conversion or received). Extended for multi-chain support: chain_balances stores per-chain native token balances and USDC balances queried from each chain's RPC. default_chain is the user's preferred settlement chain for auto-conversion during trades. receive_strict_mode gates incoming transfers to allowlisted senders only. Linked to the user's MultiChainWallet (or legacy CustodialWallet) by did + wallet_address. One record per user. All balance mutations go through backend functions to ensure atomicity and fee collection.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the wallet owner"
    },
    "wallet_address": {
      "type": "string",
      "description": "Primary wallet address (EVM address, lowercased) of the linked wallet"
    },
    "currency": {
      "type": "string",
      "enum": [
        "GBP",
        "EUR",
        "USD"
      ],
      "default": "GBP",
      "description": "Fiat currency for the user's balance"
    },
    "fiat_cents": {
      "type": "integer",
      "default": 0,
      "description": "Fiat balance in minor units (cents). 100 = 1.00. Top-ups add to this; conversions and trade purchases debit from this."
    },
    "usdc_wei": {
      "type": "string",
      "default": "0",
      "description": "USDC balance in base units (6 decimals). Stored as string to avoid integer overflow."
    },
    "chain_balances": {
      "type": "object",
      "additionalProperties": true,
      "description": "Per-chain balance snapshot from the last get-wallet-balance query. Structure: { polygon: { native_wei, usdc_wei }, ethereum: { native_wei, usdc_wei }, ..., solana: { native_lamports }, bitcoin: { native_sats } }. Refreshed on each wallet page load."
    },
    "default_chain": {
      "type": "string",
      "default": "polygon",
      "description": "The user's preferred settlement chain for auto-conversion during trades. When a trade settles in USDC, this determines which chain the USDC is locked/released on."
    },
    "receive_strict_mode": {
      "type": "boolean",
      "default": false,
      "description": "When true, incoming crypto transfers are only accepted from addresses on the user's ReceiveAllowlist or from traded contacts (completed EscrowTrade counterparties). Non-allowlisted sends are blocked at the watch layer."
    },
    "total_topup_cents": {
      "type": "integer",
      "default": 0,
      "description": "Cumulative fiat top-up amount (cents) eligible for refund. Decremented when a refund is issued."
    },
    "total_fees_paid_wei": {
      "type": "string",
      "default": "0",
      "description": "Cumulative fees paid by this user in USDC base units, for display and analytics."
    },
    "low_balance_threshold_cents": {
      "type": "integer",
      "default": 0,
      "description": "User-configurable threshold in fiat cents for low-balance alerts. 0 = disabled."
    },
    "low_balance_notified_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "did",
    "wallet_address"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}