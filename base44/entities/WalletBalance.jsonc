{
  "name": "WalletBalance",
  "type": "object",
  "title": "WalletBalance",
  "description": "org.swappulse.walletBalance \u2014 a collector's dual-currency wallet balance tracking fiat_cents (from Stripe top-ups, pre-conversion) and usdc_wei (USDC on Polygon, post-conversion or received). Linked to the user's CustodialWallet by did + wallet_address. One record per user. All balance mutations go through backend functions to ensure atomicity and fee collection. Includes a user-configurable low_balance_threshold_cents for automated low-balance alerts.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the wallet owner"
    },
    "wallet_address": {
      "type": "string",
      "description": "Polygon wallet address (lowercased) of the linked custodial wallet"
    },
    "currency": {
      "type": "string",
      "enum": [
        "GBP",
        "EUR",
        "USD"
      ],
      "default": "GBP",
      "description": "Fiat currency for the user's balance"
    },
    "fiat_cents": {
      "type": "integer",
      "default": 0,
      "description": "Fiat balance in minor units (cents). 100 = 1.00. Top-ups add to this; conversions and trade purchases debit from this."
    },
    "usdc_wei": {
      "type": "string",
      "default": "0",
      "description": "USDC balance in base units (wei). USDC has 6 decimals, so 1000000 = 1 USDC. Stored as string to avoid integer overflow on large balances."
    },
    "total_topup_cents": {
      "type": "integer",
      "default": 0,
      "description": "Cumulative fiat top-up amount (cents) that is eligible for refund. Decremented when a refund is issued. Converted USDC cannot be refunded."
    },
    "total_fees_paid_wei": {
      "type": "string",
      "default": "0",
      "description": "Cumulative fees paid by this user in USDC base units, for display and analytics."
    },
    "low_balance_threshold_cents": {
      "type": "integer",
      "default": 0,
      "description": "User-configurable threshold in fiat cents. When fiat_cents drops below this value, the platform sends a low-balance notification. 0 = alert disabled. Checked by the check-low-balances scheduled function."
    },
    "low_balance_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last low-balance notification sent. Used to throttle alerts to once per 24 hours. Reset to null when the balance recovers above the threshold."
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "did",
    "wallet_address"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}