{
  "name": "ScannerTrainingSnapshot",
  "type": "object",
  "title": "ScannerTrainingSnapshot",
  "description": "Dormant, administrator-only schema reserved for future versioned training exports. Phase 2 does not create training snapshots. Any future export must include only explicitly approved ScannerCorrection records, remain private, preserve provenance, and pass a separate operator review before use.",
  "properties": {
    "version_tag": {
      "type": "string",
      "description": "Unique version tag for this snapshot (e.g. scan-2026-08-17-v1)"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "file_uri": {
      "type": "string",
      "description": "Private file URI of the uploaded JSONL dataset (use CreateFileSignedUrl to download)"
    },
    "row_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of labelled correction rows in the snapshot"
    },
    "correction_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ScannerCorrection ids included in this snapshot (for traceability)"
    },
    "rarity_distribution": {
      "type": "object",
      "additionalProperties": true,
      "description": "Count of rows per rarity label in the snapshot"
    },
    "language_distribution": {
      "type": "object",
      "additionalProperties": true,
      "description": "Count of rows per detected language in the snapshot"
    },
    "model_version": {
      "type": "string",
      "description": "Scanner model version this snapshot is intended to retrain from"
    },
    "notes": {
      "type": "string",
      "description": "Optional admin notes about this snapshot"
    }
  },
  "required": [
    "version_tag",
    "generated_at",
    "file_uri",
    "row_count"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}