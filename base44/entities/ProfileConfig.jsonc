{
  "name": "ProfileConfig",
  "type": "object",
  "title": "ProfileConfig",
  "description": "org.swappulse.profileConfig \u2014 a collector's enhanced profile configuration: richer personal info (bio, pronouns, interests, favourites, location, contact, social links), collecting-journey milestones, per-field visibility flags (public / friends / followers / private, including trade-detail fields), profile theme (gradient or platform-emulating layout), content-block order, and section/tab visibility. One record per collector (looked up by did). RLS restricts reads/writes to the owner; the get-profile-config backend function reads via the service role and filters fields by the viewer's relationship (public / friends / followers / private) so private data never leaks to unauthorized viewers.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the owner collector (lookup key)"
    },
    "bio": {
      "type": "string",
      "maxLength": 1000,
      "description": "Longer free-form bio about the collector's journey"
    },
    "pronouns": {
      "type": "string",
      "maxLength": 40
    },
    "interests": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 60
      },
      "description": "Hobbies and interests"
    },
    "favourite_pokemon": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "favourite_sets": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "location": {
      "type": "string",
      "maxLength": 100
    },
    "website": {
      "type": "string",
      "maxLength": 200
    },
    "social_links": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "maxLength": 40
          },
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "url": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "description": "External social/profile links"
    },
    "contact_email": {
      "type": "string",
      "maxLength": 200
    },
    "milestones": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "milestone_type": {
            "type": "string",
            "enum": [
              "first_card",
              "first_trade",
              "set_completion",
              "grading",
              "custom"
            ],
            "default": "custom"
          }
        },
        "required": [
          "title",
          "milestone_type"
        ]
      },
      "description": "Collecting-journey milestones (first card, first trade, set completions, grading achievements, custom)"
    },
    "theme": {
      "type": "string",
      "enum": [
        "default",
        "vintage",
        "competitive",
        "shiny",
        "investment",
        "facebook",
        "bluesky",
        "mastodon",
        "x",
        "youtube",
        "reddit"
      ],
      "default": "default",
      "description": "Profile theme \u2014 gradient presets (default/vintage/competitive/shiny/investment) restyle the header, or platform-emulating layouts (facebook/bluesky/mastodon/x/youtube/reddit) restructure the About view into that platform's native arrangement."
    },
    "section_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered profile section/tab keys; tabs render in this order"
    },
    "block_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered content-block keys for the About section (bio, interests, milestones, contact, binder, trades, collections, hub); blocks render in this order for every visitor"
    },
    "hidden_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Section keys the owner has toggled off (Posts is never hideable)"
    },
    "field_visibility": {
      "type": "object",
      "description": "Per-field visibility: personal-info or trade-detail field name -> public | friends | followers | private. Trade-detail keys: trade_values, trade_partners, trade_dates.",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "public",
          "friends",
          "followers",
          "private"
        ]
      }
    }
  },
  "required": [
    "did"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}