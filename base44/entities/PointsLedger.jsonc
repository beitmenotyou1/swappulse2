{
  "name": "PointsLedger",
  "type": "object",
  "title": "PointsLedger",
  "description": "org.swappulse.pointsLedger \u2014 tracks usage mining points awarded to collectors for platform activity (pack openings, trades, journals, binder showcases, card reviews, vouches). Points are aggregated daily by the process-pulse-epoch function and submitted to the PulseToken contract for proportional PULSE token distribution. Admin-only access; created by backend functions (service role) when qualifying actions occur.",
  "properties": {
    "user_did": {
      "type": "string",
      "description": "AT Protocol DID of the collector who earned the points"
    },
    "user_wallet": {
      "type": "string",
      "description": "Wallet address of the collector (for on-chain points awarding)"
    },
    "action": {
      "type": "string",
      "description": "The action that earned points (PACK_OPENING, TRADE_COMPLETED, JOURNAL_PUBLISHED, BINDER_SHOWCASED, CARD_REVIEW_POSTED, VOUCH_GIVEN, NODE_UPTIME)"
    },
    "points": {
      "type": "integer",
      "description": "Number of points earned for this action"
    },
    "processed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this points entry has been included in an epoch processing"
    },
    "processed_epoch": {
      "type": "integer",
      "description": "The epoch number when this entry was processed"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this entry was processed into an epoch"
    },
    "reference_id": {
      "type": "string",
      "description": "ID of the source entity (pack opening post, escrow trade, journal, binder, card review, vouch, etc.)"
    }
  },
  "required": [
    "user_did",
    "user_wallet",
    "action",
    "points"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}