{
  "name": "TradeChain",
  "type": "object",
  "title": "TradeChain",
  "description": "org.swappulse.tradeChain \u2014 a multi-party trade chain (3-5 participants shipping cards in sequence), mirrored to AT Protocol as a real org.swappulse.tradeChain record so chains are portable and verifiable across instances.",
  "properties": {
    "participant_dids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DIDs of the 3-5 participants, in chain order"
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shipsto_dids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Next participant each ships to"
    },
    "trade_listing_uris": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shipping_confirmed": {
      "type": "array",
      "items": {
        "type": "boolean"
      }
    },
    "receipt_confirmed": {
      "type": "array",
      "items": {
        "type": "boolean"
      }
    },
    "chain_order": {
      "type": "string",
      "enum": [
        "clockwise",
        "anticlockwise"
      ],
      "default": "clockwise"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "in_transit",
        "completed",
        "cancelled"
      ],
      "default": "proposed"
    },
    "total_value": {
      "type": "number",
      "description": "Combined value in pence"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "author_name": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the chain organiser"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.tradeChain)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the chain to the organiser's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the chain has been mirrored to the AT Protocol PDS as a real org.swappulse.tradeChain record"
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the canonical record body, refreshed on each bridge push. outbound-reconcile compares it against the rebuilt record to detect silent local drift and re-push."
    }
  },
  "required": [
    "participant_dids",
    "chain_order",
    "status",
    "total_value"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}