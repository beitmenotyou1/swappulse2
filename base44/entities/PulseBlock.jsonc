{
  "name": "PulseBlock",
  "type": "object",
  "title": "PulseBlock",
  "description": "org.swappulse.pulseBlock \u2014 a PulseChain block indexed by the pulse-indexer scheduled function. One record per block number, storing the block hash, timestamp, miner/coinbase, transaction count, gas used, size, and parent hash. Written by the indexer (service role); public read for the explorer UI.",
  "properties": {
    "block_number": {
      "type": "integer",
      "description": "PulseChain block height (unique key)"
    },
    "hash": {
      "type": "string",
      "description": "Block hash (0x\u2026)"
    },
    "parent_hash": {
      "type": "string",
      "description": "Parent block hash"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Block timestamp (from the block header, converted to ISO)"
    },
    "miner": {
      "type": "string",
      "description": "Coinbase / miner address that produced this block"
    },
    "tx_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of transactions included in this block"
    },
    "gas_used": {
      "type": "string",
      "default": "0",
      "description": "Total gas used by all transactions in this block (wei, stored as string)"
    },
    "size": {
      "type": "string",
      "default": "0",
      "description": "Block size in bytes (stored as string)"
    },
    "extra_data": {
      "type": "string",
      "description": "Extra data field from the block header (hex)"
    }
  },
  "required": [
    "block_number",
    "hash",
    "timestamp"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}