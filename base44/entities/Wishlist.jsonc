{
  "name": "Wishlist",
  "type": "object",
  "title": "Wishlist",
  "description": "org.swappulse.wishlist \u2014 a card a collector wants to acquire, mirrored to AT Protocol as a real org.swappulse.wishlist record. Visibility is enforced by the SwapPulse AppView membership-check layer: the record is published to the PDS but only visible to the owner via the AppView. Enables cross-instance trade matching.",
  "properties": {
    "card_id": {
      "type": "string"
    },
    "card_name": {
      "type": "string"
    },
    "card_image": {
      "type": "string"
    },
    "set_id": {
      "type": "string"
    },
    "set_name": {
      "type": "string"
    },
    "rarity": {
      "type": "string"
    },
    "max_price": {
      "type": "number",
      "description": "Max willing to pay in pence"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the wishlist owner"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.wishlist)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the wishlist to the owner's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the wishlist has been mirrored to the AT Protocol PDS as a real org.swappulse.wishlist record"
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the canonical record body, refreshed on each bridge push. outbound-reconcile compares it against the rebuilt record to detect silent local drift and re-push."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "card_id",
    "card_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}