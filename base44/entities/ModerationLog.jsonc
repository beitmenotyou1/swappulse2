{
  "name": "ModerationLog",
  "type": "object",
  "title": "ModerationLog",
  "description": "org.swappulse.moderationLog \u2014 audit trail of moderator decisions on flagged posts and account enforcement actions.",
  "properties": {
    "moderator_id": {
      "type": "string",
      "description": "Platform user id of the moderator"
    },
    "moderator_name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "approve",
        "dismiss",
        "escalate",
        "auto-resolve",
        "auto-escalate",
        "suspend",
        "lift_suspension",
        "shadow_ban",
        "lift_shadow_ban",
        "force_delete",
        "blocklist_add",
        "blocklist_remove"
      ],
      "description": "Moderation or enforcement action taken"
    },
    "target_post_id": {
      "type": "string",
      "description": "Id of the post that was reviewed (empty for account enforcement actions)"
    },
    "target_user_id": {
      "type": "string",
      "description": "Id of the user targeted by an enforcement action (suspend, shadow ban, force delete)"
    },
    "target_author": {
      "type": "string",
      "description": "Handle or id of the flagged post's author or the enforcement target"
    },
    "labels_affected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Label identifiers involved in the decision"
    },
    "notes": {
      "type": "string",
      "description": "Optional moderator notes (e.g. suspension reason)"
    },
    "auto_generated": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "moderator_id",
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}