{
  "name": "CardReview",
  "type": "object",
  "title": "CardReview",
  "description": "org.swappulse.cardReview \u2014 a collector's multi-axis review of a specific card (artwork, playability, collectibility, investment), mirrored to AT Protocol as a real org.swappulse.cardReview record so reviews are portable and discoverable across instances. Additionally published as a site.standard.document for interoperable long-form discovery.",
  "properties": {
    "card_id": {
      "type": "string",
      "description": "TCGDex card id / cardUri"
    },
    "card_name": {
      "type": "string"
    },
    "card_image": {
      "type": "string"
    },
    "artwork": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "playability": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "collectibility": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "investment": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "review_text": {
      "type": "string",
      "maxLength": 2000
    },
    "variant": {
      "type": "string",
      "enum": [
        "normal",
        "holo",
        "reverse_holo"
      ],
      "default": "normal"
    },
    "standard_doc_uri": {
      "type": "string",
      "description": "at:// URI of the site.standard.document record (interoperable long-form metadata wrapper). Empty until the standard.site document is published."
    },
    "standard_pub_uri": {
      "type": "string",
      "description": "at:// URI of the author's per-author site.standard.publication record"
    },
    "recommend_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of site.standard.graph.recommend records pointing at this review's standard.site document"
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the reviewer"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.cardReview)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the review to the reviewer's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the review has been mirrored to the AT Protocol PDS as a real org.swappulse.cardReview record"
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the canonical record body, refreshed on each bridge push. outbound-reconcile compares it against the rebuilt record to detect silent local drift and re-push."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "card_id",
    "artwork",
    "playability",
    "collectibility",
    "investment"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}