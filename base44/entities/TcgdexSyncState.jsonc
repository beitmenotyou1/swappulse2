{
  "name": "TcgdexSyncState",
  "type": "object",
  "title": "TcgdexSyncState",
  "description": "org.swappulse.tcgdexSyncState \u2014 a single-row cursor tracking progress of the TCGDex catalogue sync. Records the current language being synced (one of 17 TCGDex-supported languages: en, fr, de, it, es, pt, jp, zh, ko, pt-br, pt-pt, nl, pl, ru, zh-cn, id, th), the index into the set list, total sets, and last-synced timestamp so sync-tcgdex-catalogue resumes where it left off and rotates through all supported languages. Written by sync-tcgdex-catalogue (service role).",
  "properties": {
    "current_lang": {
      "type": "string",
      "default": "en",
      "description": "Language code currently being synced (one of 17 TCGDex languages)"
    },
    "set_index": {
      "type": "integer",
      "default": 0,
      "description": "Index into the set list for the current language where the next sync run should resume"
    },
    "total_sets": {
      "type": "integer",
      "default": 0,
      "description": "Total sets in the current language's set list"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "sets_synced": {
      "type": "integer",
      "default": 0,
      "description": "Total sets fully synced across all languages since the cursor started"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "current_lang"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}