{
  "name": "TcgplayerUsage",
  "type": "object",
  "title": "TCGplayer Usage Budget",
  "description": "Private server-side usage ledger for TCGplayer API request volume. TCGplayer publishes no fixed numeric API ceiling in current public docs, so SwapPulse uses conservative internal soft limits and can back off on 429/retry responses.",
  "properties": {
    "bucket_key": {
      "type": "string"
    },
    "bucket_type": {
      "type": "string",
      "enum": [
        "minute",
        "day"
      ]
    },
    "calls_used": {
      "type": "integer",
      "default": 0
    },
    "soft_call_limit": {
      "type": "integer"
    },
    "provider_limit_known": {
      "type": "boolean",
      "default": false
    },
    "last_status": {
      "type": "integer"
    },
    "last_request_at": {
      "type": "string",
      "format": "date-time"
    },
    "blocked_until": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "bucket_key",
    "bucket_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}