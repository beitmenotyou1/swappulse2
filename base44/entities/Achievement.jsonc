{
  "name": "Achievement",
  "type": "object",
  "title": "Achievement",
  "description": "org.swappulse.achievement \u2014 a state-dependent, network-verified credential. Granted only when a cryptographic-style proof holds over the user's on-chain activity, and revoked when the underlying proof no longer holds (e.g. trust score drops). metadata carries the proof URIs and summary for the Proof Viewer.",
  "properties": {
    "achievement_type": {
      "type": "string",
      "enum": [
        "set_completion_25",
        "set_completion_50",
        "set_completion_75",
        "set_completion_100",
        "shiny_hunter",
        "first_trade",
        "trusted_trader",
        "chain_weaver",
        "scanner_sage",
        "binder_curator",
        "community_voice"
      ],
      "description": "The scarce achievement key. Set-completion tiers are mutually exclusive (only the highest reached tier is held)."
    },
    "status": {
      "type": "string",
      "enum": [
        "granted",
        "revoked"
      ],
      "default": "granted",
      "description": "granted while the proof holds; revoked when the evaluator detects the proof no longer holds"
    },
    "related_uri": {
      "type": "string",
      "description": "at:// URI or id of the primary linked record (e.g. the completed set id, trade chain, binder)"
    },
    "metadata": {
      "type": "object",
      "description": "Proof bundle: { metricValue, proofSummary, proofUris: string[], lastEvaluatedAt }",
      "additionalProperties": true
    },
    "unlocked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the credential was last revoked (proof stopped holding)"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the user who holds the credential (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the credential to the holder's signing key (simulated)"
    }
  },
  "required": [
    "achievement_type",
    "unlocked_at"
  ]
}