{
  "name": "Achievement",
  "type": "object",
  "title": "Achievement",
  "description": "org.swappulse.achievement \u2014 a state-dependent, network-verified credential. Granted only when the proof_type defined in the versioned config holds over the user's on-chain activity. metadata carries the proofRecords bundle for the Proof Viewer. Revocation respects the global grace period (pending_revocation_at) before a credential is fully revoked.",
  "properties": {
    "achievement_type": {
      "type": "string",
      "enum": [
        "set_completer_bronze",
        "set_completer_silver",
        "set_completer_gold",
        "set_completer_diamond",
        "shiny_hunter",
        "first_trade",
        "trusted_trader",
        "chain_weaver",
        "scanner_sage",
        "binder_curator",
        "community_voice",
        "card_reviewer"
      ],
      "description": "Achievement id from the versioned config (achievements/v1/config.json)."
    },
    "status": {
      "type": "string",
      "enum": [
        "granted",
        "revoked"
      ],
      "default": "granted",
      "description": "granted while the proof holds; revoked after the grace period elapses if the proof no longer holds"
    },
    "pending_revocation_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the proof first stopped holding; the credential is revoked only after revocation_grace_period_hours from this timestamp"
    },
    "related_uri": {
      "type": "string",
      "description": "at:// URI or id of the primary linked record (e.g. the completed set id, trade chain, binder)"
    },
    "metadata": {
      "type": "object",
      "description": "Proof bundle: { metricValue, proofSummary, proofRecords: [{uri, cid, recordType, verifiedAt}], lastEvaluatedAt }",
      "additionalProperties": true
    },
    "unlocked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the credential was fully revoked (after the grace period)"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the user who holds the credential (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the credential to the holder's signing key (simulated)"
    }
  },
  "required": [
    "achievement_type",
    "unlocked_at"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}