{
  "name": "TcgdexCard",
  "type": "object",
  "title": "TcgdexCard",
  "description": "org.swappulse.tcgdexCard \u2014 a locally-synced TCGDex catalogue card used by the scanner to resolve candidates without a live per-scan TCGDex search. One record per TCGDex card id (global across languages). name_norm_{lang} fields hold language-specific normalised names for fast exact-match lookup across all 17 TCGDex-supported languages; names holds display names per language. phash holds a 64-bit perceptual hash (8\u00d78 grayscale average hash) computed from the card image for the scanner fast-path. Synced by the sync-tcgdex-catalogue backend function.",
  "properties": {
    "card_id": {
      "type": "string",
      "description": "TCGDex global card id (same across languages)"
    },
    "set_id": {
      "type": "string",
      "description": "TCGDex set id (e.g. sv01)"
    },
    "set_name": {
      "type": "string",
      "description": "Set name in English (for display)"
    },
    "set_lang": {
      "type": "string",
      "description": "Language code of the set this card was first synced from (e.g. en, fr, ja)"
    },
    "local_id": {
      "type": "string",
      "description": "Collector number printed on the card (e.g. 025/198)"
    },
    "rarity": {
      "type": "string",
      "description": "TCGDex rarity string (e.g. Common, Rare Holo, Illustration Rare, Full Art)"
    },
    "image": {
      "type": "string",
      "description": "TCGDex image path or absolute URL used to build the card image URL"
    },
    "phash": {
      "type": "string",
      "description": "16-char hex perceptual hash (64-bit, 8\u00d78 grayscale average hash) computed from the card image. Used by the scanner fast-path for instant matching without an LLM call. Null/empty when not yet computed."
    },
    "name": {
      "type": "string",
      "description": "Card name in English (primary display name)"
    },
    "name_norm_en": {
      "type": "string",
      "description": "Normalised (lowercased, alphanumeric) English name for fast lookup"
    },
    "name_norm_fr": {
      "type": "string",
      "description": "Normalised French name"
    },
    "name_norm_de": {
      "type": "string",
      "description": "Normalised German name"
    },
    "name_norm_it": {
      "type": "string",
      "description": "Normalised Italian name"
    },
    "name_norm_es": {
      "type": "string",
      "description": "Normalised Spanish name"
    },
    "name_norm_pt": {
      "type": "string",
      "description": "Normalised Portuguese (generic) name"
    },
    "name_norm_jp": {
      "type": "string",
      "description": "Normalised Japanese name"
    },
    "name_norm_zh": {
      "type": "string",
      "description": "Normalised Chinese (Traditional) name"
    },
    "name_norm_ko": {
      "type": "string",
      "description": "Normalised Korean name"
    },
    "name_norm_pt-br": {
      "type": "string",
      "description": "Normalised Brazilian Portuguese name"
    },
    "name_norm_pt-pt": {
      "type": "string",
      "description": "Normalised European Portuguese name"
    },
    "name_norm_nl": {
      "type": "string",
      "description": "Normalised Dutch name"
    },
    "name_norm_pl": {
      "type": "string",
      "description": "Normalised Polish name"
    },
    "name_norm_ru": {
      "type": "string",
      "description": "Normalised Russian name"
    },
    "name_norm_zh-cn": {
      "type": "string",
      "description": "Normalised Simplified Chinese name"
    },
    "name_norm_id": {
      "type": "string",
      "description": "Normalised Indonesian name"
    },
    "name_norm_th": {
      "type": "string",
      "description": "Normalised Thai name"
    },
    "names": {
      "type": "object",
      "additionalProperties": true,
      "description": "Display names keyed by TCGDex language code (en, fr, de, it, es, pt, jp, zh, ko, pt-br, pt-pt, nl, pl, ru, zh-cn, id, th)"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was last refreshed from TCGDex"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "card_id",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}