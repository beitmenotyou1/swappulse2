{
  "name": "FaucetClaim",
  "type": "object",
  "title": "FaucetClaim",
  "description": "org.swappulse.faucetClaim \u2014 a testnet SWPX drip issued to a collector's smart account by the faucet. One record per claim attempt. The 24h cooldown is keyed to the canonical chain identity and every attempt fails closed against replay. The private Base44 user mapping is never written on-chain.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Private Base44 owner mapping used only for row-level access control. Never written on-chain."
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the claiming collector (metadata only)"
    },
    "network": {
      "type": "string",
      "default": "SWAPPULSE_TESTNET"
    },
    "account_address": {
      "type": "string",
      "description": "Smart account address the drip was sent to"
    },
    "chain_identity_id": {
      "type": "string",
      "description": "On-chain identity id the claim is attributed to"
    },
    "amount": {
      "type": "string",
      "default": "0",
      "description": "Amount dripped in base units (decimal string to avoid precision loss)"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUBMITTED",
        "CONFIRMED",
        "FAILED"
      ],
      "default": "SUBMITTED"
    },
    "tx_hash": {
      "type": "string",
      "description": "Faucet transfer transaction hash on the appchain"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "user_id",
    "did",
    "account_address",
    "chain_identity_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}