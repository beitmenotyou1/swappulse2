{
  "name": "Document",
  "type": "object",
  "title": "Document",
  "properties": {
    "document_type": {
      "type": "string",
      "enum": [
        "insurance_report",
        "collection_export",
        "trade_receipt"
      ]
    },
    "blob_url": {
      "type": "string",
      "description": "URL of the generated document file (PDF/JSON)"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "description": "Document-specific metadata"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the owner (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the document to the owner's signing key (simulated)"
    }
  },
  "required": [
    "document_type",
    "blob_url",
    "generated_at"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}