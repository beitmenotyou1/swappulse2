{
  "name": "SendCode",
  "type": "object",
  "title": "SendCode",
  "description": "DEPRECATED / QUARANTINED legacy custodial-wallet send-code entity. Not part of the current SwapPulse architecture. Retained only for audit/history; user access and creation are disabled.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the user who requested the send code"
    },
    "code_hash": {
      "type": "string",
      "description": "SHA-256 hash of the 6-digit one-time code (stored hashed, not plaintext)"
    },
    "purpose": {
      "type": "string",
      "default": "send_crypto",
      "description": "What the code is for (currently only send_crypto)"
    },
    "to_address": {
      "type": "string",
      "description": "Recipient address this code is bound to (must match at verification)"
    },
    "amount_wei": {
      "type": "string",
      "description": "Amount in base units this code is bound to (must match at verification)"
    },
    "chain": {
      "type": "string",
      "description": "Chain key this code is bound to (must match at verification)"
    },
    "asset": {
      "type": "string",
      "description": "Asset being sent (native symbol or USDC) \u2014 bound to the code"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code expires (60 seconds after creation)"
    },
    "used": {
      "type": "boolean",
      "default": false
    },
    "used_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "did",
    "code_hash",
    "to_address",
    "amount_wei",
    "chain",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}