{
  "name": "ReceiveAllowlist",
  "type": "object",
  "title": "ReceiveAllowlist",
  "description": "DEPRECATED / QUARANTINED legacy custodial-wallet receive allowlist. Not part of the current SwapPulse architecture. Retained only for audit/history; user access and creation are disabled.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the wallet owner who added this allowlist entry"
    },
    "address": {
      "type": "string",
      "description": "Allowed sender address (lowercased for EVM, base58 for Solana)"
    },
    "chain": {
      "type": "string",
      "description": "Chain key this allowlist entry applies to. Empty string means all chains."
    },
    "label": {
      "type": "string",
      "maxLength": 100,
      "description": "Optional label for the allowed address (e.g. a contact name)"
    },
    "added_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "did",
    "address"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}