{
  "name": "FiatTopUp",
  "type": "object",
  "title": "FiatTopUp",
  "description": "org.swappulse.fiatTopUp \u2014 a record of each Stripe top-up payment into a user's wallet. Tracks the Stripe PaymentIntent, the amount, the 2% fee, the refundable balance, and the refund status. Used to verify refund eligibility (only original fiat top-up amounts can be refunded, not converted USDC).",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the user who topped up"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID for this top-up"
    },
    "stripe_charge_id": {
      "type": "string",
      "description": "Stripe Charge ID (for refunds)"
    },
    "amount_cents": {
      "type": "integer",
      "description": "Top-up amount in fiat cents (e.g. 5000 = 50.00)"
    },
    "currency": {
      "type": "string",
      "enum": [
        "GBP",
        "EUR",
        "USD"
      ],
      "default": "GBP"
    },
    "fee_cents": {
      "type": "integer",
      "description": "2% fee in fiat cents, collected on this top-up"
    },
    "fee_usdc_wei": {
      "type": "string",
      "default": "0",
      "description": "Fee converted to USDC base units and sent to the platform fee wallet"
    },
    "fee_tx_hash": {
      "type": "string",
      "description": "On-chain tx hash of the fee USDC transfer to the platform fee wallet"
    },
    "refundable_cents": {
      "type": "integer",
      "description": "Remaining refundable amount. Decremented when a refund is issued. Cannot go below 0."
    },
    "refund_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "refunded",
        "partial"
      ],
      "default": "none"
    },
    "refunded_cents": {
      "type": "integer",
      "default": 0,
      "description": "Total amount refunded from this top-up"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed"
      ],
      "default": "pending"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "did",
    "stripe_payment_intent_id",
    "amount_cents",
    "currency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}