{
  "name": "CollectionEntry",
  "type": "object",
  "title": "CollectionEntry",
  "description": "org.swappulse.collectionEntry \u2014 a Pok\u00e9mon TCG card held in a collector's digital binder, mirrored to AT Protocol as a real org.swappulse.collectionEntry record so collection state is portable across PDSs.",
  "properties": {
    "card_id": {
      "type": "string",
      "description": "TCGDex card id"
    },
    "card_name": {
      "type": "string"
    },
    "card_image": {
      "type": "string"
    },
    "set_id": {
      "type": "string"
    },
    "set_name": {
      "type": "string"
    },
    "local_id": {
      "type": "string",
      "description": "Card number within set"
    },
    "rarity": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "mint",
        "near_mint",
        "excellent",
        "good",
        "damaged"
      ],
      "default": "near_mint"
    },
    "variant": {
      "type": "string",
      "enum": [
        "normal",
        "holo",
        "reverse_holo"
      ],
      "default": "normal"
    },
    "acquisition_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_price": {
      "type": "number",
      "description": "Purchase price in pence"
    },
    "market_value": {
      "type": "number",
      "description": "Current estimated market value in pence"
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    },
    "showcased": {
      "type": "boolean",
      "default": false,
      "description": "Whether the card is pinned to the public digital binder"
    },
    "binder_index": {
      "type": "integer",
      "default": 0,
      "description": "Display order within the digital binder"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the owner (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.collectionEntry)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the record to the owner's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the entry has been mirrored to the AT Protocol PDS as a real org.swappulse.collectionEntry record"
    }
  },
  "required": [
    "card_id",
    "card_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}