{
  "name": "ChallengeEntry",
  "type": "object",
  "title": "ChallengeEntry",
  "description": "org.swappulse.challengeEntry \u2014 a user's contribution to a challenge. The leaderboard feed generator reads the author's profile settings (SettingsConfig.config.challenges.leaderboardOptIn) to decide visibility; override_profile_visibility allows a per-entry override. status and moderator_labels gate quality (rejected / spam_suspected entries are excluded from ranking).",
  "properties": {
    "challenge_id": {
      "type": "string",
      "description": "Challenge id this entry belongs to"
    },
    "challenge_ref": {
      "type": "string",
      "description": "at:// strongRef of the challenge"
    },
    "participant_did": {
      "type": "string"
    },
    "participant_name": {
      "type": "string"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "set_progress",
        "deck_list",
        "card_pull",
        "collection_value"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "helpful-trader",
        "accuracy-champion",
        "community-builder",
        "set-completer",
        "shiny-hunter",
        "journal-writer",
        "meetup-organiser"
      ],
      "description": "Axis this contribution counts toward (must match challenge leaderboard_config.categories)"
    },
    "contribution_count": {
      "type": "integer",
      "default": 1,
      "description": "Number of items contributed toward the goal metric"
    },
    "contribution_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "description": "Supporting at:// URIs for verification / audit trail"
    },
    "verification_hash": {
      "type": "string",
      "description": "Cryptographic hash of contribution data for integrity verification"
    },
    "moderator_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "verified",
          "under_review",
          "flagged_for_review",
          "spam_suspected"
        ]
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    },
    "override_profile_visibility": {
      "type": "object",
      "description": "Temporary visibility override for this entry only. Requires explicit confirmation UI.",
      "properties": {
        "allow_on_leaderboard": {
          "type": "boolean"
        },
        "allowed_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "rejection_reason": {
      "type": "string",
      "maxLength": 200
    },
    "set_completion_percent": {
      "type": "number"
    },
    "pull_post_uri": {
      "type": "string"
    },
    "collection_total_value": {
      "type": "number"
    },
    "deck_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      }
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the participant (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the entry to the participant's signing key (simulated)"
    }
  },
  "required": [
    "challenge_id",
    "entry_type",
    "submitted_at"
  ]
}