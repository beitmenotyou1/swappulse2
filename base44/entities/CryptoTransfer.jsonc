{
  "name": "CryptoTransfer",
  "type": "object",
  "title": "CryptoTransfer",
  "description": "DEPRECATED / QUARANTINED legacy Polygon/USDC wallet transfer history. Crypto send, conversion, fee-sweep and escrow flows are not part of SwapPulse V1. Retained only for audit/history; user access and creation are disabled.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the wallet owner this transfer belongs to"
    },
    "transfer_type": {
      "type": "string",
      "enum": [
        "send",
        "receive",
        "fiat_to_usdc",
        "usdc_to_fiat",
        "token_convert",
        "escrow_lock",
        "escrow_release",
        "fee_sweep",
        "topup_credit"
      ],
      "description": "The type of crypto transfer"
    },
    "from_address": {
      "type": "string",
      "description": "Sender Polygon wallet address"
    },
    "to_address": {
      "type": "string",
      "description": "Recipient Polygon wallet address"
    },
    "amount_wei": {
      "type": "string",
      "description": "USDC amount in base units (6 decimals)"
    },
    "fee_wei": {
      "type": "string",
      "default": "0",
      "description": "2% fee in USDC base units collected on this transfer"
    },
    "tx_hash": {
      "type": "string",
      "description": "On-chain Polygon transaction hash"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "failed"
      ],
      "default": "pending"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "escrow_trade_id": {
      "type": "string",
      "description": "EscrowTrade id if this transfer is part of an escrow"
    },
    "fiat_topup_id": {
      "type": "string",
      "description": "FiatTopUp id if this is a top-up credit"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "did",
    "transfer_type",
    "amount_wei",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}