{
  "name": "WalletAlertPreference",
  "type": "object",
  "title": "WalletAlertPreference",
  "description": "org.swappulse.walletAlertPreference \u2014 a user's customizable smart rules for wallet activity notifications. Controls which event types trigger alerts, minimum amount thresholds, quiet hours, per-chain enable/disable, token allow/deny lists, and push notification delivery. One record per user. Read by the wallet-webhook receiver to filter incoming events before creating notifications.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the preference owner"
    },
    "enabled_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "incoming",
          "outgoing",
          "nft_mint",
          "nft_transfer",
          "low_balance",
          "large_tx"
        ]
      },
      "default": [
        "incoming",
        "outgoing",
        "low_balance"
      ],
      "description": "Which alert types are enabled"
    },
    "min_amount_usd": {
      "type": "number",
      "default": 0,
      "description": "Minimum USD value for a transaction to trigger an alert. 0 = all transactions."
    },
    "large_tx_threshold_usd": {
      "type": "number",
      "default": 100,
      "description": "Threshold in USD above which a transaction triggers a large_tx alert"
    },
    "quiet_hours_start": {
      "type": "string",
      "description": "Quiet hours start time (HH:MM, 24h format). Null = no quiet hours."
    },
    "quiet_hours_end": {
      "type": "string",
      "description": "Quiet hours end time (HH:MM, 24h format)"
    },
    "quiet_hours_timezone": {
      "type": "string",
      "default": "UTC",
      "description": "IANA timezone name for quiet hours (e.g. Europe/London, America/New_York)"
    },
    "per_chain_enabled": {
      "type": "object",
      "additionalProperties": true,
      "description": "Per-chain enable/disable: { polygon: true, ethereum: true, arbitrum: true, optimism: true, base: true, solana: true, bitcoin: true }"
    },
    "token_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Contract addresses to always alert on (empty = all tokens allowed)"
    },
    "token_denylist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Contract addresses to never alert on"
    },
    "push_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether to send push notifications for wallet alerts"
    },
    "in_app_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether to create in-app notifications for wallet alerts"
    }
  },
  "required": [
    "did"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        }
      ]
    }
  }
}