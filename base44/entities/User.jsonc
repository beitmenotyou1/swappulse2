{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "push_subscription": {
      "type": "string",
      "description": "Serialized PushSubscription JSON for Web Push notifications"
    },
    "username": {
      "type": "string",
      "description": "Unique username (handle)",
      "maxLength": 30
    },
    "display_name": {
      "type": "string",
      "description": "User-editable display name shown across the app and synced to the AT Protocol profile. Falls back to the built-in full_name when empty.",
      "maxLength": 64
    },
    "avatar": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "header": {
      "type": "string",
      "description": "Profile header/banner image URL"
    },
    "description": {
      "type": "string",
      "description": "User bio/description. Max 256 characters to match the AT Protocol app.bsky.actor.profile description limit.",
      "maxLength": 256
    },
    "pinned_post_id": {
      "type": "string",
      "description": "Local id of the Post pinned to the user's profile."
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether TOTP 2FA is enabled"
    },
    "two_factor_secret": {
      "type": "string",
      "description": "Base32-encoded TOTP secret"
    },
    "webauthn_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has at least one registered WebAuthn/U2F security key."
    },
    "moderation_strikes": {
      "type": "integer",
      "default": 0,
      "description": "Number of toxic-content moderation strikes accumulated by this user"
    },
    "restricted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user's account access has been restricted due to repeated moderation violations"
    },
    "login_key": {
      "type": "string",
      "description": "Random password used for passwordless email-code login"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the user"
    },
    "bsky_handle": {
      "type": "string",
      "description": "Linked Bluesky handle (set when the user links their account via Settings)."
    },
    "pds_url": {
      "type": "string",
      "description": "AT Protocol PDS base URL this user's identity authenticates against."
    },
    "pds_app_password": {
      "type": "string",
      "description": "AES-GCM encrypted PDS app password for bridge sessions. Encrypted with APP_PASSWORD_ENCRYPTION_KEY; decrypted on read by the shared userIdentity helper. Never returned in API responses."
    },
    "signing_key": {
      "type": "string",
      "description": "Local HMAC signing key for simulated AT Protocol record signatures"
    },
    "locale": {
      "type": "string",
      "description": "Preferred interface locale (e.g. en-GB, ja-JP).",
      "default": "en-GB"
    },
    "profile_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last-write-wins timestamp for profile sync."
    },
    "profile_sync_failed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the outbound profile sync failed for this user."
    },
    "profile_sync_fail_count": {
      "type": "integer",
      "default": 0,
      "description": "Consecutive outbound profile sync failures. Reset to 0 on success."
    },
    "profile_sync_pending": {
      "type": "boolean",
      "default": false,
      "description": "True when a single-user profile sync failed and needs the workflow's adminBackfill to retry. Cleared on successful sync."
    },
    "graph_reconciled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the social graph (follows + followers) was reconciled against the PDS/AppView by the PDS Sync workflow. Null/old = due for reconciliation."
    },
    "avatar_pds_ref": {
      "type": "string",
      "description": "JSON-serialized PDS blob ref for the avatar."
    },
    "header_pds_ref": {
      "type": "string",
      "description": "JSON-serialized PDS blob ref for the header/banner."
    },
    "avatar_source_url": {
      "type": "string",
      "description": "The local avatar URL (Base44 CDN) that was last successfully pushed to the PDS."
    },
    "header_source_url": {
      "type": "string",
      "description": "The local header/banner URL (Base44 CDN) that was last successfully pushed to the PDS."
    },
    "migrated_from_bluesky": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has migrated their profile from Bluesky to SwapPulse."
    },
    "original_bluesky_bio": {
      "type": "string",
      "description": "Snapshot of the user's Bluesky bio captured before migration."
    },
    "original_bluesky_profile": {
      "type": "string",
      "description": "JSON-serialized snapshot of the full original app.bsky.actor.profile record."
    },
    "pinned_announcement_uri": {
      "type": "string",
      "description": "at:// URI of the pinned 'I've moved to SwapPulse' announcement post on Bluesky."
    },
    "original_bluesky_handle": {
      "type": "string",
      "description": "The Bluesky handle the user migrated from."
    },
    "migrated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the migration was performed. Cleared on un-move."
    },
    "migration_reverted": {
      "type": "boolean",
      "default": false,
      "description": "True after the user un-moves (reverts migration). Cleared if the user re-migrates."
    },
    "handle_update_pending": {
      "type": "boolean",
      "default": false,
      "description": "True when the migration handle update failed because DNS wasn't ready."
    },
    "pending_handle": {
      "type": "string",
      "description": "The target handle that retry-pending-handles will attempt to set."
    },
    "post_backfill_cursor": {
      "type": "string",
      "description": "Pagination cursor for the resumable post backfill."
    },
    "post_backfill_complete": {
      "type": "boolean",
      "default": false,
      "description": "True once the post backfill has fully paged through the user's PDS repo. Cleared on un-move."
    },
    "likes_backfill_cursor": {
      "type": "string",
      "description": "Pagination cursor for the resumable likes backfill."
    },
    "likes_backfill_complete": {
      "type": "boolean",
      "default": false,
      "description": "True once the likes backfill has fully paged through. Cleared on un-move."
    },
    "reposts_backfill_cursor": {
      "type": "string",
      "description": "Pagination cursor for the resumable reposts backfill."
    },
    "reposts_backfill_complete": {
      "type": "boolean",
      "default": false,
      "description": "True once the reposts backfill has fully paged through. Cleared on un-move."
    },
    "lists_backfill_cursor": {
      "type": "string",
      "description": "Pagination cursor for the resumable lists/starterpacks backfill."
    },
    "lists_backfill_complete": {
      "type": "boolean",
      "default": false,
      "description": "True once the lists and starterpacks backfill has fully paged through. Cleared on un-move."
    },
    "notifications_backfill_cursor": {
      "type": "string",
      "description": "Pagination cursor for the resumable notification history backfill."
    },
    "notifications_backfill_complete": {
      "type": "boolean",
      "default": false,
      "description": "True once the notification history backfill has fully paged through. Cleared on un-move."
    },
    "notifications_imported_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the one-time Bluesky notification snapshot was imported. Cleared on un-move."
    },
    "migration_steps": {
      "type": "object",
      "description": "Per-step migration status tracking. Each key is a step name with { status, error, completed_at }.",
      "properties": {
        "profile_pull": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "post_backfill": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "likes_backfill": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "reposts_backfill": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "notification_import": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "lists_backfill": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "graph_import": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "handle_update": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "announcement": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "custom_records": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "failed"
              ]
            },
            "error": {
              "type": "string"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}