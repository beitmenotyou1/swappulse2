{
  "name": "CustodialWallet",
  "type": "object",
  "title": "CustodialWallet",
  "description": "org.swappulse.custodialWallet \u2014 a custodial Polygon wallet generated for a collector who enables crypto features. The private key is encrypted (AES-256-GCM) and stored server-side; the 24-word mnemonic is also encrypted as a backup. Unlock is gated by a passkey (WebAuthn) and/or an optional PIN. The wallet address is also recorded in WalletLink so existing mint flows work. One active custodial wallet per user.",
  "properties": {
    "wallet_address": {
      "type": "string",
      "description": "Polygon wallet address (lowercased checksum) of the custodial wallet"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the wallet owner"
    },
    "encrypted_private_key": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of the wallet's private key. Encrypted with the server encryption key (when encryption_method='server') or a PBKDF2-derived key from the PIN (when encryption_method='pin')."
    },
    "encryption_method": {
      "type": "string",
      "enum": [
        "server",
        "pin"
      ],
      "default": "server",
      "description": "How the private key is encrypted. 'server' = APP_PASSWORD_ENCRYPTION_KEY (passkey gates access). 'pin' = PBKDF2(PIN, salt)."
    },
    "mnemonic_cipher": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of the 24-word mnemonic backup. Always encrypted with the server encryption key so it can be recovered after passkey or PIN authentication."
    },
    "passkey_credential_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "WebAuthn credential IDs enrolled for wallet unlock. The public keys are stored in the WebAuthnCredential entity."
    },
    "pin_hash": {
      "type": "string",
      "description": "SHA-256 hash of the PIN (for verification). Empty if no PIN is set."
    },
    "pin_salt": {
      "type": "string",
      "description": "Random salt for PBKDF2 key derivation from the PIN. Empty if no PIN is set."
    },
    "kdf_iterations": {
      "type": "integer",
      "default": 100000,
      "description": "PBKDF2 iteration count for PIN-derived key"
    },
    "has_passkey": {
      "type": "boolean",
      "default": false,
      "description": "True if at least one passkey is enrolled for wallet unlock"
    },
    "has_pin": {
      "type": "boolean",
      "default": false,
      "description": "True if a PIN is set"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "False when the wallet is deactivated (e.g. user switched to an external wallet)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "wallet_address",
    "did",
    "encrypted_private_key",
    "encryption_method"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}