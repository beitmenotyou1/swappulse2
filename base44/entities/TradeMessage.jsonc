{
  "name": "TradeMessage",
  "type": "object",
  "title": "TradeMessage",
  "properties": {
    "trade_id": {
      "type": "string",
      "description": "TradeListing id this message belongs to"
    },
    "body": {
      "type": "string",
      "maxLength": 1000
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the sender (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the message to the sender's signing key (simulated)"
    }
  },
  "required": [
    "trade_id",
    "body"
  ]
}