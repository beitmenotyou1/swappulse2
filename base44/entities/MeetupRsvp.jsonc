{
  "name": "MeetupRsvp",
  "type": "object",
  "title": "MeetupRsvp",
  "description": "org.swappulse.meetupRsvp \u2014 an attendee's RSVP for a meetup, mirrored to AT Protocol as a real org.swappulse.meetupRsvp record. References the meetup via strongRef so RSVPs are portable and verifiable across instances.",
  "properties": {
    "meetup_ref": {
      "type": "string",
      "description": "strongRef at:// URI of the meetup"
    },
    "meetup_id": {
      "type": "string",
      "description": "Local id of the Meetup for fast lookup"
    },
    "attending": {
      "type": "string",
      "enum": [
        "yes",
        "maybe",
        "no"
      ],
      "default": "yes"
    },
    "bringing_trade_binder": {
      "type": "boolean",
      "default": false,
      "description": "Whether the attendee will bring their physical binder"
    },
    "looking_for_cards": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "description": "Card names the attendee is hunting for at the meetup"
      }
    },
    "attendee_name": {
      "type": "string"
    },
    "attendee_handle": {
      "type": "string"
    },
    "attendee_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the attendee"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.meetupRsvp)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the RSVP to the attendee's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the RSVP has been mirrored to the AT Protocol PDS as a real org.swappulse.meetupRsvp record"
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the canonical record body, refreshed on each bridge push. outbound-reconcile compares it against the rebuilt record to detect silent local drift and re-push."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "meetup_ref",
    "meetup_id",
    "attending"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}