{
  "name": "Challenge",
  "type": "object",
  "title": "Challenge",
  "description": "org.swappulse.challenge \u2014 a community challenge definition, mirrored to AT Protocol as a real org.swappulse.challenge record so challenges are discoverable across instances. Participation model is set by `mode`: collective (shared global goal, no ranking), competitive (multi-axis opt-in leaderboard), or guild (circle-scoped). `goal` defines the metric, target and quality filters; `reward` defines what contributors receive.",
  "properties": {
    "challenge_type": {
      "type": "string",
      "enum": [
        "set_sprint",
        "budget_deck",
        "pull_of_week",
        "community_goal"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "collective",
        "guild",
        "competitive"
      ],
      "default": "collective",
      "description": "Participation model"
    },
    "category": {
      "type": "string",
      "enum": [
        "helpful-trader",
        "accuracy-champion",
        "community-builder",
        "set-completer",
        "shiny-hunter",
        "journal-writer",
        "meetup-organiser"
      ],
      "description": "Leaderboard axis this challenge scores on (competitive only)"
    },
    "title": {
      "type": "string",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "rules": {
      "type": "string",
      "maxLength": 2000
    },
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "circle"
      ],
      "default": "global"
    },
    "circle_ref": {
      "type": "string",
      "description": "at:// URI of the scoping Circle (required when scope is circle)"
    },
    "goal": {
      "type": "object",
      "description": "What participants must accomplish",
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "cards_logged",
            "shiny_pulls_logged",
            "trades_completed",
            "scanner_corrections",
            "vouches_given",
            "journals_published",
            "meetups_attended",
            "sets_completed",
            "grading_submissions"
          ]
        },
        "target": {
          "type": "integer",
          "description": "Total for collective, or qualifying threshold for competitive"
        },
        "filters": {
          "type": "object",
          "properties": {
            "min_rarity": {
              "type": "string",
              "enum": [
                "common",
                "uncommon",
                "rare",
                "holo",
                "secret_rare",
                "ex",
                "v",
                "vmax",
                "rainbow"
              ]
            },
            "element_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "condition_min": {
              "type": "string",
              "enum": [
                "mint",
                "near_mint",
                "excellent",
                "good",
                "fair",
                "poor"
              ]
            },
            "min_value_usd": {
              "type": "integer",
              "description": "Minimum card value in USD cents"
            },
            "exclude_duplicates": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "reward": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "badge",
            "theme",
            "feature_unlock",
            "achievement",
            "recognition"
          ]
        },
        "badge_id": {
          "type": "string"
        },
        "theme_id": {
          "type": "string"
        },
        "shared": {
          "type": "boolean",
          "default": false,
          "description": "true: all contributors rewarded on collective completion; false: top rankers only"
        }
      }
    },
    "leaderboard_config": {
      "type": "object",
      "description": "Leaderboard settings. Ignored for collective challenges.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "helpful-trader",
              "accuracy-champion",
              "community-builder",
              "set-completer",
              "shiny-hunter",
              "journal-writer",
              "meetup-organiser"
            ]
          }
        },
        "rank_limit": {
          "type": "integer",
          "default": 100
        },
        "visibility_window_days": {
          "type": "integer",
          "default": 30
        }
      }
    },
    "target_set_code": {
      "type": "string"
    },
    "budget_limit": {
      "type": "number",
      "description": "Budget limit in pence"
    },
    "reward_badge": {
      "type": "string",
      "maxLength": 50
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "voting_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "voting",
        "completed",
        "cancelled"
      ],
      "default": "upcoming"
    },
    "winner_dids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Competitive only; populated on completion"
    },
    "creator_did": {
      "type": "string",
      "description": "DID of the challenge creator (official SwapPulse or Guild)"
    },
    "guild_approved": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "image_url": {
      "type": "string",
      "description": "Challenge banner/thumbnail URL"
    },
    "author_name": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the publisher"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.challenge)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the challenge to the publisher's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the challenge has been mirrored to the AT Protocol PDS as a real org.swappulse.challenge record"
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the canonical record body, refreshed on each bridge push. outbound-reconcile compares it against the rebuilt record to detect silent local drift and re-push."
    }
  },
  "required": [
    "challenge_type",
    "title",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}