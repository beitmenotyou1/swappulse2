{
  "name": "LoginCode",
  "type": "object",
  "title": "LoginCode",
  "description": "One-time email code stored as a keyed digest. Only backend service-role functions may access it.",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address the login code was sent to"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code expires (15 minutes after creation)"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "Whether the code has been used"
    },
    "failed_attempts": {
      "type": "integer",
      "default": 0,
      "description": "Number of failed verification attempts for this code; the code is deleted after 5 failures to prevent brute force"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "code_hash": {
      "type": "string",
      "description": "Keyed HMAC-SHA256 digest of the six-digit one-time code; the plaintext is never stored"
    }
  },
  "required": [
    "email",
    "code_hash",
    "expires_at"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}