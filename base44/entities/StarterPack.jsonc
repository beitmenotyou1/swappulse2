{
  "name": "StarterPack",
  "type": "object",
  "title": "StarterPack",
  "description": "org.swappulse.starterPack \u2014 a collector-authored onboarding bundle of member collectors, recommended Circles, pinned custom feeds, and a featured binder/journal, mirrored to AT Protocol as a real org.swappulse.starterPack record so packs are portable and discoverable across instances. Extends the imported BlueskyList pattern to native authoring + outbound bridging.",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "category": {
      "type": "string",
      "enum": [
        "vintage",
        "modern",
        "competitive",
        "investment",
        "sealed",
        "japanese",
        "trading",
        "general"
      ],
      "default": "general",
      "description": "Niche the pack onboards a newcomer into"
    },
    "member_dids": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string"
      },
      "description": "DIDs of collectors bundled in the pack"
    },
    "circle_ids": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string"
      },
      "description": "Local Circle ids recommended by the pack"
    },
    "feed_uris": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string"
      },
      "description": "at:// URIs of pinned custom feeds"
    },
    "featured_binder_id": {
      "type": "string",
      "description": "Local Binder id featured in the pack"
    },
    "featured_journal_id": {
      "type": "string",
      "description": "Local Journal id featured in the pack"
    },
    "cover_image_url": {
      "type": "string"
    },
    "subscriber_count": {
      "type": "integer",
      "default": 0
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the author"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.starterPack)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the pack to the author's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the pack has been mirrored to the AT Protocol PDS as a real org.swappulse.starterPack record"
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the canonical record body, refreshed on each bridge push. outbound-reconcile compares it against the rebuilt record to detect silent local drift and re-push."
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}