{
  "name": "CardVerificationSession",
  "type": "object",
  "title": "CardVerificationSession",
  "description": "org.swappulse.cardVerificationSession \u2014 an audit trail for a collector's attempt to prove physical ownership of a card before minting it as an on-chain NFT. Stores the uploaded scan photos, the AI vision match result (confidence + anomalies), optional grading cert verification, and the achieved verification level (0\u20133). Sessions expire after 1 hour to prevent replay or sharing. A valid verified session is referenced by mint-card to embed the verification level in the NFT metadata.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the collector requesting verification (metadata only; access is controlled by created_by_id)"
    },
    "collection_entry_id": {
      "type": "string",
      "description": "Local CollectionEntry ID being verified"
    },
    "card_id": {
      "type": "string",
      "description": "TCGDex card ID being verified"
    },
    "card_name": {
      "type": "string",
      "description": "Cached card name for display"
    },
    "scan_image_urls": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string"
      },
      "description": "Legacy public photo URLs retained for historical verification sessions only. New verification flows store private file URIs in scan_file_uris."
    },
    "scan_file_uris": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string"
      },
      "description": "Private Base44 file URIs for the collector's card photos. Signed delivery URLs are created transiently for AI analysis and are never persisted."
    },
    "ai_match_result": {
      "type": "object",
      "properties": {
        "matched": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number"
        },
        "anomalies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "physical_card_visible": {
          "type": "boolean",
          "description": "True when the submitted media visibly depicts a physical card rather than only a digital reproduction"
        },
        "is_screen_photo": {
          "type": "boolean"
        },
        "manipulation_suspected": {
          "type": "boolean",
          "description": "True when the submitted image itself appears manipulated or otherwise unsuitable for a possession check"
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "Structured result from the AI visual possession check against the TCGDex reference image. This is not an authenticity or professional grading determination."
    },
    "grading_company": {
      "type": "string",
      "enum": [
        "psa",
        "bgs",
        "cgc",
        "none"
      ],
      "default": "none",
      "description": "Grading company whose cert was submitted for Level 3 verification"
    },
    "grading_cert_number": {
      "type": "string",
      "description": "Grading certificate number submitted for Level 3 verification"
    },
    "grading_verified": {
      "type": "boolean",
      "default": false,
      "description": "True if the grading cert was successfully verified via InvokeLLM web lookup"
    },
    "verification_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 0,
      "description": "Achieved trust level: 0=self-attested, 1=scanned, 2=AI-verified scan, 3=graded cert"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "failed",
        "expired"
      ],
      "default": "pending"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the session expires (1 hour after creation for AI-verified sessions, 10 years for self-attested level-0 sessions). Expired sessions cannot be used for minting."
    }
  },
  "required": [
    "did",
    "collection_entry_id",
    "card_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}