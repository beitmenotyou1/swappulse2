{
  "name": "Conversation",
  "type": "object",
  "title": "Conversation",
  "description": "A local-only 1:1 direct-message conversation. Conversation metadata is visible only to its two participants and admins; it is never federated to an AT Protocol repository.",
  "properties": {
    "did": {
      "type": "string",
      "description": "DID of the conversation creator",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "recipient_did": {
      "type": "string",
      "description": "DID of the other participant",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "participant_dids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string"
      },
      "description": "Both participant DIDs in sorted order",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "recipient_name": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "recipient_handle": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "recipient_avatar": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_message_preview": {
      "type": "string",
      "maxLength": 200,
      "description": "Non-sensitive preview; encrypted messages use a fixed lock label."
    },
    "last_message_did": {
      "type": "string",
      "description": "DID of the participant who sent the most recent message"
    },
    "at_uri": {
      "type": "string",
      "description": "Legacy AT URI field. New conversations never federate.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "cid": {
      "type": "string",
      "description": "Legacy content identifier field.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "record_type": {
      "type": "string",
      "description": "Legacy record-type field.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "sig": {
      "type": "string",
      "description": "Legacy simulated signature field.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "Legacy flag. Must remain false for new conversations.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "content_hash": {
      "type": "string",
      "description": "Legacy bridge hash field.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "did",
    "recipient_did",
    "participant_dids"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}