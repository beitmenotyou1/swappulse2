{
  "name": "PulseTokenTransfer",
  "type": "object",
  "title": "PulseTokenTransfer",
  "description": "org.swappulse.pulseTokenTransfer \u2014 an ERC-20 or ERC-721 (NFT) token transfer parsed from a PulseChain transaction receipt's Transfer event logs. Cached by the pulse-explorer-tx function on first detail view so repeated views are fast. One record per (tx_hash, log_index). For ERC-721 transfers, is_nft is true, token_id holds the NFT token ID, and nft_name/nft_image hold metadata fetched from the contract's tokenURI. Public read for the explorer UI.",
  "properties": {
    "tx_hash": {
      "type": "string",
      "description": "Transaction hash this transfer belongs to"
    },
    "log_index": {
      "type": "integer",
      "description": "Log index within the transaction receipt (unique per tx)"
    },
    "token_contract": {
      "type": "string",
      "description": "Token contract address (0x\u2026, lowercased)"
    },
    "from_address": {
      "type": "string",
      "description": "Sender of the transfer (0x\u2026)"
    },
    "to_address": {
      "type": "string",
      "description": "Recipient of the transfer (0x\u2026)"
    },
    "value": {
      "type": "string",
      "default": "0",
      "description": "Amount transferred (base units for ERC-20, '1' for ERC-721, stored as string)"
    },
    "token_symbol": {
      "type": "string",
      "description": "Token symbol (e.g. PULSE, USDC) \u2014 fetched from the contract, cached here. 'NFT' for ERC-721 transfers."
    },
    "token_decimals": {
      "type": "integer",
      "default": 18,
      "description": "Token decimals (fetched from the contract, cached here). 0 for ERC-721 transfers."
    },
    "is_nft": {
      "type": "boolean",
      "default": false,
      "description": "True if this is an ERC-721 (NFT) transfer. ERC-721 Transfer events have 4 indexed topics (from, to, tokenId) vs ERC-20's 3 (from, to)."
    },
    "token_id": {
      "type": "string",
      "description": "NFT token ID (for ERC-721 transfers). Empty for ERC-20 transfers."
    },
    "nft_name": {
      "type": "string",
      "description": "NFT name from metadata (for ERC-721 transfers). Fetched from the contract's tokenURI JSON. Empty for ERC-20."
    },
    "nft_image": {
      "type": "string",
      "description": "NFT image URL from metadata (for ERC-721 transfers). Fetched from the contract's tokenURI JSON. Empty for ERC-20."
    }
  },
  "required": [
    "tx_hash",
    "log_index",
    "token_contract",
    "from_address",
    "to_address",
    "value"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}