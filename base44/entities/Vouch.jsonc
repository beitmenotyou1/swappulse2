{
  "name": "Vouch",
  "type": "object",
  "title": "Vouch",
  "description": "org.swappulse.vouch \u2014 a collector's vouch for another collector's trustworthiness, mirrored to AT Protocol as a real org.swappulse.vouch record so the trust graph is portable and verifiable across PDSs and SwapPulse instances.",
  "properties": {
    "vouched_did": {
      "type": "string",
      "description": "DID of the endorsed user"
    },
    "vouched_name": {
      "type": "string"
    },
    "vouched_handle": {
      "type": "string"
    },
    "voucher_name": {
      "type": "string"
    },
    "voucher_handle": {
      "type": "string"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "trade_partner",
        "community_member",
        "personal_acquaintance",
        "repeat_trader"
      ]
    },
    "context": {
      "type": "string",
      "maxLength": 280,
      "description": "Brief explanation of why this vouch is given"
    },
    "trade_refs": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "description": "strongRef at:// URI of a completed trade record supporting this vouch"
      }
    },
    "revocable": {
      "type": "boolean",
      "default": true
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the voucher"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.vouch)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the vouch to the voucher's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the vouch has been mirrored to the AT Protocol PDS as a real org.swappulse.vouch record"
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the canonical record body, refreshed on each bridge push. outbound-reconcile compares it against the rebuilt record to detect silent local drift and re-push."
    }
  },
  "required": [
    "vouched_did",
    "relationship",
    "context"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}