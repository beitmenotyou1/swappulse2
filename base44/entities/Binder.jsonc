{
  "name": "Binder",
  "type": "object",
  "title": "Binder",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "cover_image_uri": {
      "type": "string",
      "description": "Optional blob URI for custom binder cover art"
    },
    "theme": {
      "type": "string",
      "enum": [
        "classic_purple",
        "holo_foil",
        "vintage_leather",
        "midnight",
        "rainbow",
        "custom"
      ],
      "default": "classic_purple"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "slots": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "properties": {
                "slot_index": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "collection_entry_uri": {
                  "type": "string",
                  "description": "at:// URI of the collectionEntry record in this slot"
                },
                "custom_caption": {
                  "type": "string",
                  "maxLength": 100
                }
              }
            }
          }
        }
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "followers",
        "private"
      ],
      "default": "public"
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "like_count": {
      "type": "integer",
      "default": 0
    },
    "view_count": {
      "type": "integer",
      "default": 0
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the binder author (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the binder to the author's signing key (simulated)"
    }
  },
  "required": [
    "title",
    "visibility"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}