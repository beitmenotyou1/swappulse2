{
  "name": "AgentInsight",
  "type": "object",
  "title": "AgentInsight",
  "description": "org.swappulse.agentInsight \u2014 Quarantined improvement candidates derived from feedback. Candidates are inactive until an administrator reviews and approves them. Non-admin readers can only see approved records.",
  "properties": {
    "agent_name": {
      "type": "string",
      "description": "Name of the agent this insight applies to"
    },
    "insight_type": {
      "type": "string",
      "enum": [
        "improvement_note",
        "common_correction",
        "strength",
        "weakness",
        "pattern"
      ],
      "description": "Category of insight"
    },
    "content": {
      "type": "string",
      "maxLength": 1000,
      "description": "The insight text \u2014 actionable guidance for the agent"
    },
    "evidence_count": {
      "type": "integer",
      "default": 1,
      "description": "Number of feedback items supporting this insight"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "description": "Confidence score 0-1 based on evidence strength"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "When this insight expires (null = never)"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ],
      "default": "pending_review",
      "description": "Human-review state. Only approved records may influence an agent."
    },
    "safety_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "passed",
        "flagged"
      ],
      "default": "unreviewed",
      "description": "Result of prompt-injection and sensitive-content screening."
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "user_feedback",
        "moderation_feedback",
        "curated",
        "migration"
      ],
      "default": "user_feedback"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Base44 administrator user id that made the review decision."
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string",
      "maxLength": 500
    },
    "active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this approved insight is currently available to an agent."
    },
    "source_feedback_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy administrator-only audit field. New learning-loop candidates do not copy feedback record ids into agent-readable content."
    }
  },
  "required": [
    "agent_name",
    "insight_type",
    "content",
    "generated_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.review_status": "approved"
            },
            {
              "data.safety_status": "passed"
            },
            {
              "data.active": true
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}