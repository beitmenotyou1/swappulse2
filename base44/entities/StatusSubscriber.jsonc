{
  "name": "StatusSubscriber",
  "type": "object",
  "title": "StatusSubscriber",
  "description": "org.swappulse.statusSubscriber \u2014 a status page subscriber who receives email notifications when incidents occur or resolve. Uses double-opt-in confirmation with an expiring single-use confirmation token and a persistent high-entropy unsubscribe token.",
  "properties": {
    "email": {
      "type": "string",
      "description": "Subscriber email address (lowercased)"
    },
    "confirm_token": {
      "type": "string",
      "description": "High-entropy single-use confirmation token. Cleared after successful confirmation."
    },
    "confirm_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiry time for the confirmation token. Confirmation links are valid for 24 hours."
    },
    "confirm_consumed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the confirmation capability token was consumed."
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the subscriber confirmed their email (null = pending)"
    },
    "unsubscribe_token": {
      "type": "string",
      "description": "High-entropy persistent token for one-click unsubscribe from status emails"
    },
    "preferences": {
      "type": "object",
      "properties": {
        "incidents": {
          "type": "boolean",
          "default": true
        },
        "resolutions": {
          "type": "boolean",
          "default": true
        },
        "maintenance": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "email",
    "unsubscribe_token"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}