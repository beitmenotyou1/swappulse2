{
  "name": "Story",
  "type": "object",
  "title": "Story",
  "description": "org.swappulse.story \u2014 an ephemeral 24-hour story, mirrored to AT Protocol as a real org.swappulse.story record. Stories expire client-side after 24 hours; the PDS record remains for audit but the AppView filters expired stories from feeds.",
  "properties": {
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "Ordered media segments composing the story (org.swappulse.story lexicon). Falls back to legacy single content/image_uri when empty.",
      "items": {
        "type": "object",
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "media_blob": {
            "type": "string",
            "description": "Uploaded image or video URL"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "text",
              "card"
            ]
          },
          "text_overlay": {
            "type": "string",
            "maxLength": 200,
            "description": "Text rendered over the media"
          },
          "text_position": {
            "type": "string",
            "enum": [
              "top",
              "center",
              "bottom"
            ],
            "default": "center"
          },
          "background_color": {
            "type": "string",
            "description": "Hex colour behind text overlay, or legacy gradient key"
          },
          "card_embed_uri": {
            "type": "string",
            "description": "TCGDex card id of an embedded card segment"
          },
          "card_name": {
            "type": "string"
          },
          "card_image": {
            "type": "string"
          },
          "duration": {
            "type": "integer",
            "minimum": 3,
            "maximum": 15,
            "default": 5,
            "description": "Display duration in seconds for non-video segments"
          }
        }
      }
    },
    "audience": {
      "type": "string",
      "enum": [
        "friends",
        "public"
      ],
      "default": "friends",
      "description": "Who can view this story. 'friends' restricts to accepted mutual friendships."
    },
    "story_group": {
      "type": "string",
      "description": "Identifier grouping segments into one story (record rkey)"
    },
    "content": {
      "type": "string",
      "maxLength": 280,
      "description": "Legacy: text body for single text stories"
    },
    "image_uri": {
      "type": "string",
      "description": "Legacy: uploaded image URL for single image stories"
    },
    "bg_gradient": {
      "type": "string",
      "enum": [
        "purple",
        "sunset",
        "ocean"
      ],
      "default": "purple",
      "description": "Legacy: gradient key for text-story backgrounds"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the story becomes invisible (createdAt + 24h)"
    },
    "viewed_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy denormalized seen DIDs (view tracking now uses StoryView records)"
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the author"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.story)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the story to the author's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the story has been mirrored to the AT Protocol PDS as a real org.swappulse.story record"
    }
  },
  "required": [
    "expires_at",
    "audience"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}