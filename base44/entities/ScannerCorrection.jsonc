{
  "name": "ScannerCorrection",
  "type": "object",
  "title": "ScannerCorrection",
  "description": "org.swappulse.scannerCorrection \u2014 a user-submitted correction for an AI card scanner misidentification. Used to improve the scanner model through a feedback learning loop. The original image hash links to stored image data; the corrected card ID references the TCGDex catalog.",
  "properties": {
    "image_hash": {
      "type": "string",
      "description": "SHA-256 hash of the original scanned image. Used to retrieve the stored image for training."
    },
    "image_url": {
      "type": "string",
      "description": "URL of the scanned image. The imageHash is the permanent reference."
    },
    "predicted_card_id": {
      "type": "string",
      "description": "The TCGDex card ID the scanner predicted. Empty string if the scanner failed to produce any result."
    },
    "predicted_set_id": {
      "type": "string",
      "description": "The TCGDex set ID of the predicted card."
    },
    "predicted_card_name": {
      "type": "string"
    },
    "corrected_card_id": {
      "type": "string",
      "description": "The TCGDex card ID the user identified as correct."
    },
    "corrected_set_id": {
      "type": "string",
      "description": "The TCGDex set ID of the corrected card."
    },
    "corrected_card_name": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "description": "The scanner's confidence score (0.0 to 1.0) for the original prediction. 0.0 if no prediction was made."
    },
    "correction_type": {
      "type": "string",
      "enum": [
        "wrong_card",
        "wrong_set",
        "wrong_variant",
        "no_match_found",
        "confirm_correct"
      ],
      "description": "The nature of the correction. 'confirm_correct' is a positive training signal."
    },
    "scanner_version": {
      "type": "string",
      "description": "Version tag of the scanner model that produced the prediction."
    },
    "notes": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional user notes about the correction."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "original_scan_uri": {
      "type": "string",
      "description": "Legacy \u2014 URI of the original scanned image blob"
    },
    "original_prediction": {
      "type": "object",
      "description": "Legacy \u2014 full prediction object from the scanner"
    },
    "corrected_by": {
      "type": "string",
      "description": "User id of the correcting user"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the corrector (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the correction to the corrector's signing key (simulated)"
    }
  },
  "required": [
    "corrected_card_id",
    "correction_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}