{
  "name": "Circle",
  "type": "object",
  "title": "Circle",
  "description": "org.swappulse.circle \u2014 a collector circle (themed community group), mirrored to AT Protocol as a real org.swappulse.circle record so circles are portable community objects across PDSs and SwapPulse instances. Circle membership is encoded in member_dids so the AppView membership-check layer can resolve who may see circle-scoped content.",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "member_dids": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "description": "AT Protocol DID of a member"
      }
    },
    "member_profiles": {
      "type": "array",
      "maxItems": 100,
      "description": "Denormalized display cache parallel to member_dids",
      "items": {
        "type": "object",
        "properties": {
          "did": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          }
        }
      }
    },
    "member_count": {
      "type": "integer",
      "default": 1
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "members_visible",
        "public"
      ],
      "default": "public"
    },
    "theme": {
      "type": "string",
      "enum": [
        "vintage",
        "competitive",
        "shiny",
        "investment",
        "local_region",
        "artist",
        "general"
      ],
      "default": "general"
    },
    "region": {
      "type": "string",
      "description": "Geographic region for local circles, e.g. 'UK-South-East'"
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the circle curator"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.circle)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the circle to the curator's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the circle has been mirrored to the AT Protocol PDS as a real org.swappulse.circle record"
    }
  },
  "required": [
    "name",
    "visibility"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}