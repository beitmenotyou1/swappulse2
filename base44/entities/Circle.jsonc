{
  "name": "Circle",
  "type": "object",
  "title": "Circle",
  "description": "Circle metadata and optional public federation projection. Local access is granted only by CircleAuthority and participant-authenticated CircleMembershipEvent records, never member_dids.",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "member_dids": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "description": "AT Protocol DID of a member"
      }
    },
    "member_profiles": {
      "type": "array",
      "maxItems": 100,
      "description": "Denormalized display cache parallel to member_dids",
      "items": {
        "type": "object",
        "properties": {
          "did": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          }
        }
      }
    },
    "member_count": {
      "type": "integer",
      "default": 1
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "members_visible",
        "public"
      ],
      "default": "public"
    },
    "theme": {
      "type": "string",
      "enum": [
        "vintage",
        "competitive",
        "shiny",
        "investment",
        "local_region",
        "artist",
        "general"
      ],
      "default": "general"
    },
    "region": {
      "type": "string",
      "description": "Geographic region for local circles, e.g. 'UK-South-East'"
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the circle curator"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.circle)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the circle to the curator's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the circle has been mirrored to the AT Protocol PDS as a real org.swappulse.circle record"
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the canonical record body, refreshed on each bridge push. outbound-reconcile compares it against the rebuilt record to detect silent local drift and re-push."
    }
  },
  "required": [
    "name",
    "visibility"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.visibility": "public"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}
