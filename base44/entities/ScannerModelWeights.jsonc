{
  "name": "ScannerModelWeights",
  "type": "object",
  "title": "ScannerModelWeights",
  "description": "org.swappulse.scannerModelWeights \u2014 a per-card confidence adjustment derived from accepted ScannerCorrection records, applied by scan-card when ranking candidates so the scanner improves between offline retrains. confirm_correct raises the weight (capped at 1.5); wrong_card/wrong_set/wrong_variant lowers it (floored at 0.3). One record per card_id. Written by submitScannerCorrection via the service role.",
  "properties": {
    "card_id": {
      "type": "string",
      "description": "TCGDex card id this weight applies to"
    },
    "weight": {
      "type": "number",
      "default": 1.0,
      "description": "Multiplier applied to the candidate's base score (0.3\u20131.5)"
    },
    "confirm_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of confirm_correct corrections for this card"
    },
    "wrong_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of wrong_* corrections where this card was the (incorrect) prediction"
    },
    "last_applied_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the weight was last recomputed from corrections"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "card_id",
    "weight"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}