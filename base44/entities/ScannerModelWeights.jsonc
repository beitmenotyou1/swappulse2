{
  "name": "ScannerModelWeights",
  "type": "object",
  "title": "ScannerModelWeights",
  "description": "Dormant, administrator-only schema reserved for a future evaluated weighting pipeline. The Phase 2 batch scanner does not read or write these weights. Only corrections that have passed quarantine and explicit administrator approval may be considered by a separately reviewed future process.",
  "properties": {
    "card_id": {
      "type": "string",
      "description": "TCGDex card id this weight applies to"
    },
    "weight": {
      "type": "number",
      "default": 1.0,
      "description": "Multiplier applied to the candidate's base score (0.3\u20131.5)"
    },
    "confirm_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of confirm_correct corrections for this card"
    },
    "wrong_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of wrong_* corrections where this card was the (incorrect) prediction"
    },
    "last_applied_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the weight was last recomputed from corrections"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "card_id",
    "weight"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}