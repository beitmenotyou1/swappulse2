{
  "name": "TradeListing",
  "type": "object",
  "title": "TradeListing",
  "description": "org.swappulse.tradeListing \u2014 a peer-to-peer card trade listing published by a collector, mirrored to AT Protocol as a real org.swappulse.tradeListing record. Offer/wanted card sets reference TCGDex catalog records; status tracks the trade lifecycle.",
  "properties": {
    "offer_card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "offer_card_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "offer_card_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wanted_card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wanted_card_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "negotiating",
        "pending_ship",
        "completed",
        "cancelled"
      ],
      "default": "open"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "wishlist_only",
        "circle_scoped"
      ],
      "default": "public"
    },
    "circle_ref": {
      "type": "string",
      "description": "strongRef at:// URI of the circle that can see this listing (when visibility is circle_scoped)"
    },
    "shipping_regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_currency": {
      "type": "string",
      "enum": [
        "GBP",
        "EUR",
        "USD"
      ],
      "default": "GBP"
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional listing expiry (max 90 days from creation). When present and past, the listing is no longer visible."
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the listing author (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.tradeListing)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the listing to the author's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the listing has been mirrored to the AT Protocol PDS as a real org.swappulse.tradeListing record"
    }
  },
  "required": [
    "offer_card_names",
    "wanted_card_names"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}