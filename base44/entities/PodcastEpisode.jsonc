{
  "name": "PodcastEpisode",
  "type": "object",
  "title": "PodcastEpisode",
  "description": "org.swappulse.podcastEpisode \u2014 a podcast episode (often derived from a voice space recording), mirrored to AT Protocol as a real org.swappulse.podcastEpisode record so episodes are portable and playable across instances. Hosts edit metadata (title, description, cover, tags, chapter marks, show notes) and set start/end trim points after recording; the trimmed audio re-encodes and replaces audio_url. Episodes are included in the host's RSS feed for external distribution.",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "audio_url": {
      "type": "string",
      "description": "Processed MP3/M4A/WebM audio file URL (replaced with the trimmed file when the host applies start/end trim)"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "episode_number": {
      "type": "integer",
      "minimum": 1
    },
    "season_number": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "cover_image_url": {
      "type": "string"
    },
    "source_space_id": {
      "type": "string",
      "description": "Original voice space record if derived from a recording"
    },
    "chapter_marks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp_seconds": {
            "type": "integer"
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "card_uri": {
            "type": "string"
          }
        }
      }
    },
    "show_notes": {
      "type": "string",
      "maxLength": 5000
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 30
      }
    },
    "trim_start_seconds": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Applied start-trim offset in seconds. The published audio_url already reflects the trim; this field records the cut for display/restoration."
    },
    "trim_end_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Applied end-trim point in seconds (offset from the original recording start). Null/0 means no end trim."
    },
    "original_audio_url": {
      "type": "string",
      "description": "The un-trimmed original recording URL, retained so the host can re-trim or restore the full audio later."
    },
    "play_count": {
      "type": "integer",
      "default": 0
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "host_name": {
      "type": "string"
    },
    "host_handle": {
      "type": "string"
    },
    "host_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the host"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.podcastEpisode)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the episode to the host's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the episode has been mirrored to the AT Protocol PDS as a real org.swappulse.podcastEpisode record"
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the canonical record body, refreshed on each bridge push. outbound-reconcile compares it against the rebuilt record to detect silent local drift and re-push."
    }
  },
  "required": [
    "title",
    "audio_url",
    "duration_seconds",
    "published_at"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}