{
  "name": "BankAccount",
  "type": "object",
  "title": "BankAccount",
  "description": "org.swappulse.bankAccount \u2014 a collector's bank account details (IBAN + BIC/Swift code) used when crypto features are disabled. Top-ups via Stripe are routed to this bank account, and trade payments pull from the linked bank account via the Stripe payment method. The IBAN and BIC are stored AES-256-GCM encrypted using APP_PASSWORD_ENCRYPTION_KEY and shown masked in the UI. One active bank account per user.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the bank account owner"
    },
    "iban_cipher": {
      "type": "string",
      "description": "AES-256-GCM encrypted IBAN (encrypted with APP_PASSWORD_ENCRYPTION_KEY)"
    },
    "bic_cipher": {
      "type": "string",
      "description": "AES-256-GCM encrypted BIC/Swift code (encrypted with APP_PASSWORD_ENCRYPTION_KEY)"
    },
    "iban_masked": {
      "type": "string",
      "description": "Masked IBAN for display (first 4 + \u2022\u2022\u2022\u2022 + last 4)"
    },
    "bic_masked": {
      "type": "string",
      "description": "Masked BIC for display (first 4 + \u2022\u2022\u2022\u2022)"
    },
    "account_holder_name": {
      "type": "string",
      "description": "Name of the account holder"
    },
    "bank_name": {
      "type": "string",
      "description": "Bank name (derived from BIC or entered by user)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "did",
    "iban_cipher",
    "bic_cipher",
    "iban_masked"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        }
      ]
    }
  }
}