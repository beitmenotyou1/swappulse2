{
  "name": "BankAccount",
  "type": "object",
  "title": "BankAccount",
  "description": "DEPRECATED / QUARANTINED legacy bank-account entity from the removed custodial wallet design. Not part of current SwapPulse V1. Retained only for audit/history; ordinary user access is disabled.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the bank account owner"
    },
    "iban_cipher": {
      "type": "string",
      "description": "AES-256-GCM encrypted IBAN (encrypted with APP_PASSWORD_ENCRYPTION_KEY)"
    },
    "bic_cipher": {
      "type": "string",
      "description": "AES-256-GCM encrypted BIC/Swift code (encrypted with APP_PASSWORD_ENCRYPTION_KEY)"
    },
    "iban_masked": {
      "type": "string",
      "description": "Masked IBAN for display (first 4 + •••• + last 4)"
    },
    "bic_masked": {
      "type": "string",
      "description": "Masked BIC for display (first 4 + ••••)"
    },
    "account_holder_name": {
      "type": "string",
      "description": "Name of the account holder"
    },
    "bank_name": {
      "type": "string",
      "description": "Bank name (derived from BIC or entered by user)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "did",
    "iban_cipher",
    "bic_cipher",
    "iban_masked"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
