{
  "name": "VoiceSpace",
  "type": "object",
  "title": "VoiceSpace",
  "description": "org.swappulse.voiceSpace \u2014 a live audio space. Two modes: 'external' (manual Go Live declaration pointing at an external stream URL on Twitch/YouTube/etc.) and 'in_platform' (a true in-platform X-Spaces-style stage where participants hear each other via a WebRTC peer mesh). Mirrored to AT Protocol as a real org.swappulse.voiceSpace record so live spaces are discoverable across instances.",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 120,
      "description": "Space title (5\u2013120 chars)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "space_mode": {
      "type": "string",
      "enum": [
        "external",
        "in_platform"
      ],
      "default": "external",
      "description": "external = manual Go Live with an external stream URL (Twitch/YouTube/etc.); in_platform = a true in-platform audio stage using a WebRTC peer mesh."
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "ended",
        "cancelled"
      ],
      "default": "live",
      "description": "Lifecycle state. Go Live creates records with status 'live'; auto-end or host End sets 'ended'."
    },
    "stream_url": {
      "type": "string",
      "description": "External stream URL (external mode only) on any platform (Twitch, YouTube, Kick, Facebook Gaming, Rumble, custom RTMP, etc.)"
    },
    "platform": {
      "type": "string",
      "enum": [
        "twitch",
        "youtube",
        "kick",
        "facebook_gaming",
        "rumble",
        "custom",
        "other"
      ],
      "description": "Streaming platform \u2014 auto-detected from stream_url or manually selected (external mode only)"
    },
    "planned_duration_minutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 480,
      "description": "Planned duration in minutes (user-selected, 15\u2013480)"
    },
    "auto_end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Calculated end time = started_at + planned_duration_minutes. The live ring disappears after this instant."
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the space went live"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the space ended or was cancelled"
    },
    "viewer_count_estimate": {
      "type": "integer",
      "description": "Optional manual entry for approximate viewer count (not auto-fetched)"
    },
    "co_host_dids": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      },
      "description": "AT Protocol DIDs of co-hosts"
    },
    "topic_tags": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 30
      }
    },
    "card_uris_discussed": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string"
      },
      "description": "Cards referenced during the space for catalogue cross-linking"
    },
    "recording_enabled": {
      "type": "boolean",
      "default": false,
      "description": "True while the host is recording the in-platform stage audio. Toggled mid-session; drives the visible REC indicator."
    },
    "recording_available": {
      "type": "boolean",
      "default": false,
      "description": "Whether a recording is available post-space"
    },
    "recording_blob_url": {
      "type": "string",
      "description": "Uploaded recording file URL (mixed stage audio for in-platform spaces)"
    },
    "recording_duration_seconds": {
      "type": "integer",
      "description": "Duration of the recording in seconds"
    },
    "peak_listener_count": {
      "type": "integer",
      "default": 0,
      "description": "Peak listener count reached during the space"
    },
    "listener_count": {
      "type": "integer",
      "default": 0,
      "description": "Final listener count at end time"
    },
    "podcast_episode_id": {
      "type": "string",
      "description": "Local id of the PodcastEpisode created from this space's recording"
    },
    "podcast_episode_uri": {
      "type": "string",
      "description": "at:// URI of podcast episode if converted from a recording"
    },
    "host_name": {
      "type": "string"
    },
    "host_handle": {
      "type": "string"
    },
    "host_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the host"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.voiceSpace)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the record to the host's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the space has been mirrored to the AT Protocol PDS as a real org.swappulse.voiceSpace record"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}