{
  "name": "VoiceSpace",
  "type": "object",
  "title": "VoiceSpace",
  "description": "org.swappulse.voiceSpace \u2014 manual live stream declaration, mirrored to AT Protocol as a real org.swappulse.voiceSpace record so live streams are discoverable across instances. A collector goes live by pasting an external stream URL; their profile shows a red live ring until the planned duration elapses or they end the stream.",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 120,
      "description": "Stream title (5\u2013120 chars)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "ended",
        "cancelled"
      ],
      "default": "live",
      "description": "Lifecycle state. Manual Go Live creates records with status 'live'; auto-end sets 'ended'."
    },
    "stream_url": {
      "type": "string",
      "description": "External stream URL on any platform (Twitch, YouTube, Kick, Facebook Gaming, Rumble, custom RTMP, etc.)"
    },
    "platform": {
      "type": "string",
      "enum": [
        "twitch",
        "youtube",
        "kick",
        "facebook_gaming",
        "rumble",
        "custom",
        "other"
      ],
      "description": "Streaming platform \u2014 auto-detected from stream_url or manually selected"
    },
    "planned_duration_minutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 480,
      "description": "Planned stream duration in minutes (user-selected, 15\u2013480)"
    },
    "auto_end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Calculated end time = started_at + planned_duration_minutes. The live ring disappears after this instant."
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the stream went live"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the stream ended or was cancelled"
    },
    "viewer_count_estimate": {
      "type": "integer",
      "description": "Optional manual entry for approximate viewer count (not auto-fetched)"
    },
    "co_host_dids": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      },
      "description": "AT Protocol DIDs of co-hosts"
    },
    "topic_tags": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 30
      }
    },
    "card_uris_discussed": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string"
      },
      "description": "Cards referenced during the stream for catalog cross-linking"
    },
    "recording_available": {
      "type": "boolean",
      "default": false,
      "description": "Whether a recording is available post-stream"
    },
    "podcast_episode_uri": {
      "type": "string",
      "description": "at:// URI of podcast episode if converted from a recording"
    },
    "host_name": {
      "type": "string"
    },
    "host_handle": {
      "type": "string"
    },
    "host_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the host"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.voiceSpace)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the stream to the host's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the stream has been mirrored to the AT Protocol PDS as a real org.swappulse.voiceSpace record"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}