{
  "name": "RecommendationPreference",
  "type": "object",
  "title": "RecommendationPreference",
  "description": "org.swappulse.recommendationPreference \u2014 per-user controls for the Who to Follow feed: dismissed candidates, target personas, region exclusions, similarity threshold, serendipity toggle, and acceptance counters.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the owner (the user these prefs apply to)"
    },
    "dismissed_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "DIDs the user has dismissed from the Who to Follow feed"
    },
    "dismissal_reasons": {
      "type": "object",
      "additionalProperties": true,
      "description": "Map of dismissed DID -> reason code (not_relevant, already_know_them, too_similar, etc.)"
    },
    "target_personas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Personas the user wants more of in their feed"
    },
    "exclude_regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Regions to exclude from recommendations"
    },
    "max_similarity_score": {
      "type": "integer",
      "default": 85,
      "description": "Above this collection-overlap score, similarity weight is reduced to avoid echo chambers"
    },
    "serendipity_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether to inject random picks from outside the trust graph"
    },
    "new_user_boost": {
      "type": "boolean",
      "default": true,
      "description": "Whether fresh accounts get a visibility boost"
    },
    "recommendation_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "weekly"
    },
    "show_why_recommended": {
      "type": "boolean",
      "default": true,
      "description": "Whether to surface recommendation reasons in the UI"
    },
    "max_suggestions_per_batch": {
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 25
    },
    "last_refreshed_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_shown": {
      "type": "integer",
      "default": 0
    },
    "total_accepted": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "did"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}