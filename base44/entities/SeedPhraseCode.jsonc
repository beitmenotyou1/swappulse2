{
  "name": "SeedPhraseCode",
  "type": "object",
  "title": "SeedPhraseCode",
  "description": "DEPRECATED / QUARANTINED legacy seed-phrase reveal code. The current SwapPulse architecture does not reveal or server-store seed phrases. Retained only for audit/history; user access and creation are disabled.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the collector who requested the seed phrase code"
    },
    "code_hash": {
      "type": "string",
      "description": "SHA-256 hash of the 6-digit one-time code (stored hashed, not plaintext)"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code expires (60 seconds after creation)"
    },
    "used": {
      "type": "boolean",
      "default": false
    },
    "used_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "did",
    "code_hash",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}