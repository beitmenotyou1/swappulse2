{
  "name": "MultiChainWallet",
  "type": "object",
  "title": "MultiChainWallet",
  "description": "DEPRECATED / QUARANTINED legacy custodial multi-chain wallet entity. Not part of the current SwapPulse architecture. Retained only for audit/history; user access and creation are disabled.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the wallet owner"
    },
    "evm_private_key_cipher": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of the EVM private key (shared across all EVM chains)"
    },
    "evm_address": {
      "type": "string",
      "description": "EVM wallet address (lowercased) \u2014 same on Polygon, Ethereum, Arbitrum, Optimism, Base"
    },
    "solana_seed_cipher": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of the 32-byte Solana seed (hex)"
    },
    "solana_address": {
      "type": "string",
      "description": "Solana public key (base58)"
    },
    "bitcoin_priv_key_cipher": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of the 32-byte Bitcoin private key (hex)"
    },
    "bitcoin_address": {
      "type": "string",
      "description": "Bitcoin P2WPKH (bech32) address (bc1q...)"
    },
    "bitcoin_cash_address": {
      "type": "string",
      "description": "Bitcoin Cash CashAddr address (bitcoincash:q...)"
    },
    "dogecoin_address": {
      "type": "string",
      "description": "Dogecoin P2PKH address (D...)"
    },
    "litecoin_address": {
      "type": "string",
      "description": "Litecoin P2PKH address (L...)"
    },
    "mnemonic_cipher": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of the 24-word mnemonic (always server-key encrypted for recovery)"
    },
    "encryption_method": {
      "type": "string",
      "enum": [
        "server",
        "pin"
      ],
      "default": "server",
      "description": "How the private keys are encrypted. 'server' = APP_PASSWORD_ENCRYPTION_KEY (passkey gates access). 'pin' = PBKDF2(PIN, salt)."
    },
    "passkey_credential_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "WebAuthn credential IDs enrolled for wallet unlock"
    },
    "pin_hash": {
      "type": "string",
      "description": "SHA-256 hash of the PIN (for verification). Empty if no PIN is set."
    },
    "pin_salt": {
      "type": "string",
      "description": "Random salt for PBKDF2 key derivation from the PIN"
    },
    "kdf_iterations": {
      "type": "integer",
      "default": 100000
    },
    "has_passkey": {
      "type": "boolean",
      "default": false
    },
    "has_pin": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "did",
    "evm_private_key_cipher",
    "evm_address",
    "encryption_method"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}