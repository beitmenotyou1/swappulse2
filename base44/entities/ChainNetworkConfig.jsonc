{
  "name": "ChainNetworkConfig",
  "type": "object",
  "title": "ChainNetworkConfig",
  "description": "Admin-managed public configuration for SwapPulse Network test environments. Contains only public blockchain configuration, never private keys, seed phrases, API secrets, or passkey secret material.",
  "properties": {
    "network": {
      "type": "string",
      "enum": [
        "SWAPPULSE_TESTNET"
      ],
      "default": "SWAPPULSE_TESTNET"
    },
    "chain_id": {
      "type": "string",
      "description": "Expected Starknet chain id returned by starknet_chainId, encoded as 0x-prefixed hex. Reconciliation fails closed if the RPC reports a different chain."
    },
    "account_class_hash": {
      "type": "string",
      "description": "Declared SwapPulseAccount class hash for this network."
    },
    "identity_registry_class_hash": {
      "type": "string",
      "description": "Declared IdentityRegistry class hash expected at identity_registry_address. Reconciliation verifies this before trusting registry reads."
    },
    "identity_registry_address": {
      "type": "string",
      "description": "Deployed IdentityRegistry contract address."
    },
    "identity_registry_owner": {
      "type": "string",
      "description": "Expected public owner/admin address returned by IdentityRegistry.owner(). Verification fails closed if the deployed registry has a different owner."
    },
    "identity_verifier_address": {
      "type": "string",
      "description": "Public verifier/attester account authorised by IdentityRegistry.is_verifier(). This account is deliberately separate from registry ownership."
    },
    "identity_verification_mode": {
      "type": "string",
      "enum": [
        "V1",
        "V2"
      ],
      "default": "V1",
      "description": "Public IdentityRegistry attestation ABI/policy mode. V2 enables assurance type/level plus spent attestation replay identifiers after the registry and relay have been upgraded."
    },
    "recovery_controller": {
      "type": "string",
      "description": "Public recovery-controller contract/account address. Empty disables recovery controller at deployment."
    },
    "recovery_delay_seconds": {
      "type": "integer",
      "default": 172800,
      "minimum": 0,
      "maximum": 2592000
    },
    "native_token_address": {
      "type": "string",
      "description": "Deployed NativeToken (staking token) contract address."
    },
    "native_token_class_hash": {
      "type": "string",
      "description": "Expected NativeToken class hash at native_token_address."
    },
    "native_token_symbol": {
      "type": "string",
      "description": "Deployed native token ticker. Must never be PULSE or PLS \u2014 those belong to PulseChain, a live traded token \u2014 so the field stays empty until branding is cleared."
    },
    "card_nft_address": {
      "type": "string",
      "description": "Deployed CardNft contract address used for card-possession NFTs."
    },
    "card_nft_class_hash": {
      "type": "string",
      "description": "Expected CardNft class hash at card_nft_address."
    },
    "staking_pool_address": {
      "type": "string",
      "description": "Deployed StakingPool contract address."
    },
    "staking_pool_class_hash": {
      "type": "string",
      "description": "Expected StakingPool class hash at staking_pool_address."
    },
    "usership_address": {
      "type": "string",
      "description": "Deployed ProofOfUsership contract address."
    },
    "usership_class_hash": {
      "type": "string",
      "description": "Expected ProofOfUsership class hash at usership_address."
    },
    "bridge_adapter_address": {
      "type": "string",
      "description": "Deployed BridgeAdapter contract address."
    },
    "bridge_adapter_class_hash": {
      "type": "string",
      "description": "Expected BridgeAdapter class hash at bridge_adapter_address."
    },
    "usership_epoch": {
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "description": "Current Proof-of-Usership scoring epoch, advanced by the aggregation workflow."
    },
    "rpc_url": {
      "type": "string",
      "description": "Optional public RPC endpoint for read-only reconciliation. Do not store authenticated/private RPC URLs here."
    },
    "explorer_url": {
      "type": "string",
      "description": "Optional public explorer base URL."
    },
    "status": {
      "type": "string",
      "enum": [
        "UNCONFIGURED",
        "CONFIGURED",
        "PAUSED"
      ],
      "default": "UNCONFIGURED"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time Base44 independently verified the configured chain ID and contract classes through the public RPC."
    },
    "verified_chain_id": {
      "type": "string",
      "description": "Chain ID observed during the last successful RPC verification."
    },
    "verified_identity_registry_class_hash": {
      "type": "string",
      "description": "IdentityRegistry class hash observed at identity_registry_address during the last successful verification."
    },
    "verified_identity_registry_owner": {
      "type": "string",
      "description": "IdentityRegistry owner observed during the last successful verification."
    },
    "verified_identity_verifier_address": {
      "type": "string",
      "description": "Verifier address confirmed authorised by IdentityRegistry.is_verifier() during the last successful verification."
    },
    "verified_identity_verification_mode": {
      "type": "string",
      "description": "Identity verification mode independently confirmed by the network verification flow. Consumers fail closed if it differs from identity_verification_mode."
    },
    "verified_account_class_hash": {
      "type": "string",
      "description": "SwapPulseAccount class hash confirmed declared during the last successful verification."
    },
    "verified_native_token_class_hash": {
      "type": "string",
      "description": "NativeToken class hash independently observed at native_token_address."
    },
    "verified_card_nft_class_hash": {
      "type": "string",
      "description": "CardNft class hash independently observed at card_nft_address."
    },
    "verified_staking_pool_class_hash": {
      "type": "string",
      "description": "StakingPool class hash independently observed at staking_pool_address."
    },
    "verified_usership_class_hash": {
      "type": "string",
      "description": "ProofOfUsership class hash independently observed at usership_address."
    },
    "verified_bridge_adapter_class_hash": {
      "type": "string",
      "description": "BridgeAdapter class hash independently observed at bridge_adapter_address."
    },
    "verified_rpc_url": {
      "type": "string",
      "description": "Public RPC URL used for the last successful verification."
    },
    "verified_by": {
      "type": "string",
      "description": "Base44 admin user id that initiated the last successful verification."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string",
      "description": "Base44 admin user id that last changed the configuration."
    }
  },
  "required": [
    "network",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}