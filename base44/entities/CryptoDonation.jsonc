{
  "name": "CryptoDonation",
  "type": "object",
  "title": "CryptoDonation",
  "description": "org.swappulse.cryptoDonation \u2014 a cryptocurrency donation via NowPayments. Created waiting by the create-crypto-donation backend function and updated by the nowpayments-ipn webhook on payment status changes. Public read; writes restricted to admins (the service role creates/updates via backend functions).",
  "properties": {
    "nowpayments_id": {
      "type": "string",
      "description": "NowPayments payment id (unique)"
    },
    "order_id": {
      "type": "string",
      "description": "SwapPulse-generated unique order reference (e.g. DON-1692345678-ab3k9x)"
    },
    "donor_name": {
      "type": "string"
    },
    "donor_email": {
      "type": "string",
      "description": "Optional donor email for a confirmation receipt"
    },
    "price_amount": {
      "type": "number",
      "description": "Donation amount in USD"
    },
    "price_currency": {
      "type": "string",
      "default": "usd"
    },
    "pay_currency": {
      "type": "string",
      "description": "Crypto currency symbol (e.g. usdcsol, btc)"
    },
    "pay_amount": {
      "type": "number",
      "description": "Exact crypto amount to send"
    },
    "pay_address": {
      "type": "string",
      "description": "Deposit wallet address"
    },
    "payment_url": {
      "type": "string",
      "description": "Optional hosted checkout URL"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "waiting",
        "confirming",
        "confirmed",
        "sending",
        "partly_paid",
        "finished",
        "failed",
        "expired",
        "refunded"
      ],
      "default": "waiting"
    },
    "ipn_received_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "nowpayments_id",
    "order_id",
    "price_amount",
    "pay_currency",
    "payment_status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}