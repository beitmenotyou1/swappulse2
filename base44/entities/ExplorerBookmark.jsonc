{
  "name": "ExplorerBookmark",
  "type": "object",
  "title": "ExplorerBookmark",
  "description": "org.swappulse.explorerBookmark \u2014 a bookmarked wallet address saved by a collector in the blockchain explorer for quick access. Stored in the user's account so bookmarks sync across devices. The frontend also mirrors to browser local storage for guest/offline access. One bookmark per (wallet_address, chain) combination per user.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the bookmark owner"
    },
    "wallet_address": {
      "type": "string",
      "description": "Bookmarked wallet address (lowercased)"
    },
    "label": {
      "type": "string",
      "description": "Optional user-defined label for the bookmark (e.g. 'Vitalik', 'My trade partner')"
    },
    "chain": {
      "type": "string",
      "default": "pulse",
      "description": "Chain key this address is bookmarked on (pulse, ethereum, polygon, etc.)"
    }
  },
  "required": [
    "did",
    "wallet_address"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}