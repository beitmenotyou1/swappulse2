{
  "name": "TokenBlocklist",
  "type": "object",
  "title": "TokenBlocklist",
  "description": "org.swappulse.tokenBlocklist \u2014 a registry of known malicious, scam, or fake token contract addresses per chain. Used by get-wallet-balance and receive-processing to auto-hide and quarantine malicious tokens so they never appear in a user's wallet or interact with their balance. Seeded from open-source blocklists (e.g. Phantom) and community reports; admin-managed.",
  "properties": {
    "chain": {
      "type": "string",
      "description": "Chain key (polygon, ethereum, arbitrum, optimism, base, solana, bitcoin)"
    },
    "contract_address": {
      "type": "string",
      "description": "Token contract address (lowercased for EVM) or mint address (Solana)"
    },
    "token_symbol": {
      "type": "string",
      "description": "Symbol of the malicious token (for display in admin UI)"
    },
    "token_name": {
      "type": "string",
      "description": "Name of the malicious token"
    },
    "reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Why this token is blocked (e.g. honeypot, phishing, rugpull, fake airdrop)"
    },
    "source": {
      "type": "string",
      "description": "Where the blocklist entry came from (e.g. phantom-blocklist, community-report, admin)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "added_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "chain",
    "contract_address"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}