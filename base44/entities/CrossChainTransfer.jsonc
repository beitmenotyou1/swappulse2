{
  "name": "CrossChainTransfer",
  "type": "object",
  "title": "CrossChainTransfer",
  "description": "DEPRECATED / QUARANTINED legacy LayerZero PulseChain/Polygon bridge transfer design. Bridges are not part of SwapPulse V1. Retained only for audit/history; user access and creation are disabled.",
  "properties": {
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the user who initiated the transfer"
    },
    "from_chain": {
      "type": "string",
      "enum": [
        "pulse",
        "polygon"
      ],
      "description": "Source chain key"
    },
    "to_chain": {
      "type": "string",
      "enum": [
        "pulse",
        "polygon"
      ],
      "description": "Destination chain key"
    },
    "from_lz_chain_id": {
      "type": "integer",
      "description": "LayerZero V2 chain ID of the source chain"
    },
    "to_lz_chain_id": {
      "type": "integer",
      "description": "LayerZero V2 chain ID of the destination chain"
    },
    "from_address": {
      "type": "string",
      "description": "Sender wallet address on the source chain"
    },
    "to_address": {
      "type": "string",
      "description": "Recipient wallet address on the destination chain"
    },
    "amount_wei": {
      "type": "string",
      "description": "Amount of $PULSE transferred in base units (18 decimals), stored as string to avoid overflow"
    },
    "lz_gas_cost_wei": {
      "type": "string",
      "description": "LayerZero network gas cost paid by the sender (in native gas units)"
    },
    "swap_pulse_fee_wei": {
      "type": "string",
      "description": "SwapPulse platform fee collected (base fee + variable fee) in $PULSE base units"
    },
    "tx_hash": {
      "type": "string",
      "description": "On-chain transaction hash of the send() call on the source chain"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered",
        "failed"
      ],
      "default": "pending",
      "description": "Transfer status: pending (sent but not yet received), delivered (minted on destination), failed (timed out or reverted)"
    },
    "message_id": {
      "type": "string",
      "description": "LayerZero message ID (keccak256 hash of the payload) for cross-chain tracking"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the transfer was initiated on the source chain"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the transfer was confirmed on the destination chain"
    },
    "failed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the transfer was marked as failed"
    },
    "failure_reason": {
      "type": "string",
      "description": "Reason for failure (e.g. 'Timeout', 'Reverted on destination')"
    }
  },
  "required": [
    "did",
    "from_chain",
    "to_chain",
    "from_address",
    "to_address",
    "amount_wei",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}