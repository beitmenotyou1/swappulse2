{
  "name": "PulseIndexerCursor",
  "type": "object",
  "title": "PulseIndexerCursor",
  "description": "org.swappulse.pulseIndexerCursor \u2014 a single-row cursor tracking the PulseChain indexer's progress. Records the last fully-indexed block number so the pulse-indexer scheduled function resumes where it left off. On first run (no cursor), the indexer starts from chain head minus PULSE_INDEXER_LOOKBACK (default 200) so the explorer shows recent activity immediately; full backfill from block 0 can be configured by setting a low PULSE_INDEXER_LOOKBACK. Admin-only access; written by pulse-indexer (service role).",
  "properties": {
    "last_indexed_block": {
      "type": "integer",
      "default": 0,
      "description": "Last fully-indexed PulseChain block number"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the indexer last ran"
    },
    "chain_head_at_last_run": {
      "type": "integer",
      "default": 0,
      "description": "Chain head block number observed at the start of the last run"
    },
    "blocks_indexed_total": {
      "type": "integer",
      "default": 0,
      "description": "Cumulative blocks indexed since the cursor was created"
    },
    "txs_indexed_total": {
      "type": "integer",
      "default": 0,
      "description": "Cumulative transactions indexed since the cursor was created"
    }
  },
  "required": [
    "last_indexed_block"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}