{
  "name": "AppPassword",
  "type": "object",
  "title": "AppPassword",
  "description": "A scoped, revocable application password tied to a collector's SwapPulse identity, used to authenticate with external AT Protocol apps (Bluesky clients, third-party PDS tools). The password_hash is a one-way hash for auth validation; password_cipher is AES-encrypted for reversible re-reveal after email-code verification. Owner-only access via RLS.",
  "properties": {
    "label": {
      "type": "string",
      "maxLength": 60,
      "description": "User-chosen label identifying the app this password is for (e.g. 'Bluesky app')"
    },
    "scope": {
      "type": "string",
      "enum": [
        "read_only",
        "read_write",
        "full_access"
      ],
      "description": "Permission scope: read_only blocks writes; read_write allows record CRUD but blocks account-level changes; full_access allows everything except account deletion"
    },
    "password_hash": {
      "type": "string",
      "description": "One-way SHA-256 hash of the app password for auth validation (never reversible)"
    },
    "password_cipher": {
      "type": "string",
      "description": "AES-GCM encrypted app password for reversible re-reveal after email-code verification"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the password was last used to authenticate an external app"
    },
    "last_used_app": {
      "type": "string",
      "description": "User-agent or app identifier from the most recent auth request"
    }
  },
  "required": [
    "label",
    "scope",
    "password_hash",
    "password_cipher"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}