{
  "name": "AppPassword",
  "type": "object",
  "title": "AppPassword",
  "description": "Legacy SwapPulse-specific scoped credential. New creation and plaintext reveal are disabled while the product migrates towards standard AT Protocol OAuth. Existing credentials may continue to validate until revoked. Secret fields are service-role/admin only and must never be returned directly to the browser.",
  "properties": {
    "label": {
      "type": "string",
      "maxLength": 60,
      "description": "User-chosen label identifying the app this password is for (e.g. 'Bluesky app')"
    },
    "scope": {
      "type": "string",
      "enum": [
        "read_only",
        "read_write",
        "full_access"
      ],
      "description": "Permission scope: read_only blocks writes; read_write allows record CRUD but blocks account-level changes; full_access allows everything except account deletion"
    },
    "password_hash": {
      "type": "string",
      "description": "One-way SHA-256 hash of the app password for auth validation (never reversible)"
    },
    "password_cipher": {
      "type": "string",
      "description": "Deprecated encrypted plaintext copy. No longer used for reveal and should be cleared from existing records."
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the password was last used to authenticate an external app"
    },
    "last_used_app": {
      "type": "string",
      "description": "User-agent or app identifier from the most recent auth request"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "label",
    "scope",
    "password_hash"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}