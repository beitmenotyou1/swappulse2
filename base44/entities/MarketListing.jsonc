{
  "name": "MarketListing",
  "type": "object",
  "title": "MarketListing",
  "properties": {
    "card_id": {
      "type": "string",
      "description": "TCGDex card id"
    },
    "card_name": {
      "type": "string"
    },
    "card_image": {
      "type": "string"
    },
    "set_name": {
      "type": "string"
    },
    "rarity": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "mint",
        "near_mint",
        "excellent",
        "good",
        "damaged"
      ],
      "default": "near_mint"
    },
    "variant": {
      "type": "string",
      "enum": [
        "normal",
        "holo",
        "reverse_holo"
      ],
      "default": "normal"
    },
    "price": {
      "type": "number",
      "description": "Sale price in major currency units (e.g. 19.99)"
    },
    "currency": {
      "type": "string",
      "enum": [
        "GBP",
        "EUR",
        "USD"
      ],
      "default": "GBP"
    },
    "shipping_regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "sold",
        "cancelled"
      ],
      "default": "active"
    },
    "checkout_session_id": {
      "type": "string",
      "description": "Wix checkout session id while payment is pending"
    },
    "buyer_did": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_handle": {
      "type": "string"
    },
    "seller_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the seller (simulated)"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (simulated)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the listing to the seller's signing key (simulated)"
    }
  },
  "required": [
    "card_name",
    "price",
    "currency",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}