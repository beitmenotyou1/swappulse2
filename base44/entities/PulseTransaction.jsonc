{
  "name": "PulseTransaction",
  "type": "object",
  "title": "PulseTransaction",
  "description": "org.swappulse.pulseTransaction \u2014 a PulseChain transaction indexed by the pulse-indexer scheduled function. One record per transaction hash, storing sender, recipient, value, gas, nonce, block, and timestamp. status and gas_used are filled from the receipt on first detail-view (the indexer does not fetch receipts to stay fast). Public read for the explorer UI.",
  "properties": {
    "tx_hash": {
      "type": "string",
      "description": "Transaction hash (0x\u2026, unique key)"
    },
    "block_number": {
      "type": "integer",
      "description": "Block height this transaction was included in"
    },
    "from_address": {
      "type": "string",
      "description": "Sender address (0x\u2026, lowercased)"
    },
    "to_address": {
      "type": "string",
      "description": "Recipient address (0x\u2026, lowercased). Empty for contract-creation transactions."
    },
    "value_wei": {
      "type": "string",
      "default": "0",
      "description": "Native PLS value transferred (wei, stored as string)"
    },
    "gas_price": {
      "type": "string",
      "default": "0",
      "description": "Gas price paid (wei, stored as string)"
    },
    "gas_limit": {
      "type": "string",
      "default": "0",
      "description": "Gas limit (wei, stored as string)"
    },
    "gas_used": {
      "type": "string",
      "default": "0",
      "description": "Gas actually used (filled from receipt on first detail view; 0 until then)"
    },
    "nonce": {
      "type": "integer",
      "default": 0,
      "description": "Sender nonce"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "unknown"
      ],
      "default": "unknown",
      "description": "Transaction status from the receipt. 'unknown' until the receipt is fetched on first detail view."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Block timestamp (ISO) \u2014 when the transaction was mined"
    },
    "input_data": {
      "type": "string",
      "description": "Transaction input data (hex 0x\u2026)"
    },
    "is_contract_creation": {
      "type": "boolean",
      "default": false,
      "description": "True if this transaction deployed a contract (to_address is empty)"
    },
    "created_contract": {
      "type": "string",
      "description": "Address of the contract created (filled from receipt on detail view)"
    }
  },
  "required": [
    "tx_hash",
    "block_number",
    "from_address",
    "value_wei"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}