{
  "name": "PdsCredential",
  "type": "object",
  "title": "PdsCredential",
  "description": "Server-side store for a user's AT Protocol PDS app password. Created by provision-did when a user gets a real did:plc; read by atproto-bridge resolveSession to authenticate per-user PDS sessions. RLS blocks all client access \u2014 only the service role (which bypasses RLS) can read or write these records. Never log or return the app_password value in any API response.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user id this credential belongs to"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol did:plc associated with this credential"
    },
    "pds_url": {
      "type": "string",
      "description": "PDS base URL this credential authenticates against"
    },
    "app_password": {
      "type": "string",
      "description": "Persistent PDS app password for bridge sessions (returned once by createAppPassword, cannot be retrieved again)"
    }
  },
  "required": [
    "user_id",
    "did",
    "app_password"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}