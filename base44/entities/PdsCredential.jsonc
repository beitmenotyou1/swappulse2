{
  "name": "PdsCredential",
  "type": "object",
  "title": "PdsCredential",
  "description": "Backend-only PDS credential store. No browser or admin entity access; service role reads and writes after canonical identity checks.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user id this credential belongs to"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol did:plc associated with this credential"
    },
    "pds_url": {
      "type": "string",
      "description": "PDS base URL this credential authenticates against"
    },
    "app_password": {
      "type": "string",
      "description": "Persistent PDS app password for bridge sessions (returned once by createAppPassword, cannot be retrieved again)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "did",
    "app_password"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}