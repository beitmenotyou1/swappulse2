{
  "name": "Feedback",
  "type": "object",
  "title": "Feedback",
  "description": "org.swappulse.feedback \u2014 collector feedback submitted via the in-app feedback button (page snapshot + comment), categorised and rated, routed to the team for review.",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "suggestion",
        "bug",
        "comment"
      ],
      "default": "comment",
      "description": "Feedback type: suggestion (new feature idea), bug (issue report), or comment (general insight)"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "description": "Short headline summarising the feedback"
    },
    "comment": {
      "type": "string",
      "maxLength": 5000,
      "description": "The collector's written feedback"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Optional 1-5 star rating of the experience"
    },
    "page": {
      "type": "string",
      "description": "Route path the collector was viewing when they submitted feedback"
    },
    "screenshot_url": {
      "type": "string",
      "description": "Uploaded screenshot of the current page (image URL)"
    },
    "user_agent": {
      "type": "string"
    },
    "viewport": {
      "type": "string",
      "description": "Viewport size, e.g. 1440x900"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "resolved"
      ],
      "default": "new"
    }
  },
  "required": [
    "category",
    "comment",
    "page"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}