{
  "name": "Reaction",
  "type": "object",
  "title": "Reaction",
  "description": "org.swappulse.reaction \u2014 a collector's reaction to a post (insane_pull, jealous, congrats, trade_interest, etc.), mirrored to AT Protocol as a real org.swappulse.reaction record. References the post via strongRef so reactions are portable and verifiable across instances.",
  "properties": {
    "subject": {
      "type": "string",
      "description": "strongRef at:// URI of the post being reacted to"
    },
    "post_id": {
      "type": "string",
      "description": "Local id of the reacted Post for fast lookup"
    },
    "reaction_type": {
      "type": "string",
      "enum": [
        "insane_pull",
        "jealous",
        "congrats",
        "trade_interest",
        "gratz_set",
        "better_luck",
        "wow"
      ]
    },
    "target_card_uri": {
      "type": "string",
      "description": "If trade_interest, the specific card URI the reactor wants"
    },
    "reactor_name": {
      "type": "string"
    },
    "reactor_handle": {
      "type": "string"
    },
    "reactor_avatar": {
      "type": "string"
    },
    "did": {
      "type": "string",
      "description": "AT Protocol DID of the reactor"
    },
    "at_uri": {
      "type": "string",
      "description": "at:// URI of this record (real once bridged to the PDS)"
    },
    "cid": {
      "type": "string",
      "description": "Content identifier hash (simulated)"
    },
    "record_type": {
      "type": "string",
      "description": "SwapPulse lexicon NSID (org.swappulse.reaction)"
    },
    "sig": {
      "type": "string",
      "description": "HMAC signature binding the reaction to the reactor's signing key (simulated)"
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "True once the reaction has been mirrored to the AT Protocol PDS as a real org.swappulse.reaction record"
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the canonical record body, refreshed on each bridge push. outbound-reconcile compares it against the rebuilt record to detect silent local drift and re-push."
    }
  },
  "required": [
    "subject",
    "reaction_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}