{
  "name": "AuthRateLimit",
  "type": "object",
  "title": "AuthRateLimit",
  "description": "Server-managed authentication throttling. The email field may contain a normalised email for login-code limits or a namespaced SHA-256-derived key for credential-verification endpoints. Never stores plaintext passwords or authentication codes.",
  "properties": {
    "email": {
      "type": "string",
      "description": "Lowercased email or namespaced hashed authentication identifier used as the throttle key"
    },
    "count": {
      "type": "integer",
      "default": 0,
      "description": "Number of code requests in the current 1-hour window"
    },
    "window_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the current 1-hour rate-limit window"
    },
    "last_request_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the most recent code request was made"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}