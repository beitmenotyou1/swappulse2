{
  "name": "FiatDonation",
  "type": "object",
  "title": "FiatDonation",
  "description": "A Stripe Checkout donation record. Created pending by the backend and visible only to admins. Completion is recorded only after verify-fiat-donation-session confirms the Checkout Session directly with Stripe.",
  "properties": {
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session id — the unique link from a payment back to the donor record"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Donation amount in major currency units (GBP)"
    },
    "currency": {
      "type": "string",
      "default": "gbp"
    },
    "donor_email": {
      "type": "string",
      "description": "Donor email (Stripe requires it for receipts)"
    },
    "donor_name": {
      "type": "string"
    },
    "payment_intent_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "expired",
        "failed"
      ],
      "default": "pending"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "stripe_session_id",
    "amount",
    "currency",
    "payment_status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
