{
  "name": "DirectMessage",
  "type": "object",
  "title": "DirectMessage",
  "description": "A local-only end-to-end encrypted 1:1 message. AT Protocol repositories are public, so direct messages are never federated. The sender is bound to the authenticated user's DID at creation; the recipient can read the ciphertext and mark it read only through the backend read-receipt function.",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Local id of the Conversation this message belongs to"
    },
    "conversation_ref": {
      "type": "string",
      "description": "Legacy field retained for old records. New DMs do not federate and leave this empty."
    },
    "did": {
      "type": "string",
      "description": "DID of the sender"
    },
    "recipient_did": {
      "type": "string",
      "description": "DID of the recipient"
    },
    "body": {
      "type": "string",
      "maxLength": 4000,
      "description": "E2EE ciphertext prefixed with e2ee:. New plaintext messages are rejected before persistence."
    },
    "escrow_key_cipher": {
      "type": "string",
      "description": "Legacy escrow field retained only for backwards compatibility. New messages do not populate it.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "True once the recipient opens the thread. Mutated only by the backend read-receipt function."
    },
    "at_uri": {
      "type": "string",
      "description": "Legacy AT URI field. New direct messages never federate."
    },
    "cid": {
      "type": "string",
      "description": "Legacy content identifier field."
    },
    "record_type": {
      "type": "string",
      "description": "Legacy record-type field."
    },
    "sig": {
      "type": "string",
      "description": "Legacy simulated signature field."
    },
    "bridged": {
      "type": "boolean",
      "default": false,
      "description": "Legacy flag. Must remain false for new direct messages."
    },
    "content_hash": {
      "type": "string",
      "description": "Legacy bridge hash field."
    }
  },
  "required": [
    "conversation_id",
    "did",
    "recipient_did",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_did": "{{user.data.did}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.did": "{{user.data.did}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}