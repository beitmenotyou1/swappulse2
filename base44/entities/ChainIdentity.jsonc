{
  "name": "ChainIdentity",
  "type": "object",
  "title": "ChainIdentity",
  "description": "Private Base44 mirror of a SwapPulse Network identity. The blockchain is authoritative. Contains no private keys, seed phrases, WebAuthn secret material, email address, date of birth, or AT Protocol credentials.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Private Base44 user id mapped to this chain identity. Never written on-chain."
    },
    "chain_identity_id": {
      "type": "string",
      "description": "Opaque public felt252 identity identifier, encoded as 0x-prefixed hex."
    },
    "account_address": {
      "type": "string",
      "description": "SwapPulse smart-account contract address on the configured testnet."
    },
    "network": {
      "type": "string",
      "enum": [
        "SWAPPULSE_TESTNET"
      ],
      "default": "SWAPPULSE_TESTNET"
    },
    "account_class_hash": {
      "type": "string",
      "description": "Declared SwapPulseAccount class hash used for this account deployment."
    },
    "identity_registry_address": {
      "type": "string",
      "description": "IdentityRegistry contract address for this network."
    },
    "age_policy_version": {
      "type": "string",
      "description": "Private Base44 snapshot of the age-policy version that permitted this identity reservation. Never written on-chain."
    },
    "eligibility_basis": {
      "type": "string",
      "enum": [
        "SELF_DECLARED",
        "THIRD_PARTY_VERIFIED"
      ],
      "description": "Private Base44 audit snapshot of the eligibility basis. Never written on-chain."
    },
    "signer_public_key": {
      "type": "string",
      "description": "Public Stark signer key reserved for this testnet account. This is public cryptographic material, never a private key."
    },
    "deployment_tx_hash": {
      "type": "string",
      "description": "Deploy-account transaction hash, when known."
    },
    "recovery_config_tx_hash": {
      "type": "string",
      "description": "Signed account-self transaction hash that configured the testnet recovery controller/delay, when known."
    },
    "registration_tx_hash": {
      "type": "string",
      "description": "IdentityRegistry registration transaction hash, when known."
    },
    "verification_tx_hash": {
      "type": "string",
      "description": "IdentityRegistry verification-attestation transaction hash, when a stronger private verification was committed on-chain."
    },
    "verification_revoke_tx_hash": {
      "type": "string",
      "description": "IdentityRegistry verification-revocation transaction hash, when a verifier assertion was withdrawn, expired or otherwise failed closed."
    },
    "verification_root": {
      "type": "string",
      "description": "Public opaque verification commitment mirrored from IdentityRegistry. Contains no plaintext age or identity evidence."
    },
    "verification_schema_hash": {
      "type": "string",
      "description": "Public generic schema identifier mirrored from IdentityRegistry."
    },
    "verification_type": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "default": 0,
      "description": "Generic public V2 assurance category mirrored from IdentityRegistry. Zero means legacy V1/no V2 assurance metadata."
    },
    "verification_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "default": 0,
      "description": "Generic public V2 assurance strength mirrored from IdentityRegistry. It never encodes DOB, document type or private verifier evidence."
    },
    "verification_attestation_id": {
      "type": "string",
      "description": "Opaque public replay identifier mirrored from IdentityRegistry V2. It is independently keyed and contains no plaintext identity evidence."
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "NONE",
        "ACTIVE",
        "EXPIRED",
        "REVOKED"
      ],
      "default": "NONE"
    },
    "verification_attested_by": {
      "type": "string",
      "description": "Public attester address mirrored from IdentityRegistry."
    },
    "verification_verified_at": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "verification_expires_at": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "verification_revoked_at": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "verification_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "signer_version": {
      "type": "string",
      "enum": [
        "STARK_V1",
        "P256_WEBAUTHN_V2"
      ],
      "default": "STARK_V1",
      "description": "Public signer scheme version only. No signer secret is stored."
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "DEPLOYED",
        "REGISTERED",
        "MERGED",
        "RECOVERY_PENDING",
        "RECOVERED",
        "FAILED"
      ],
      "default": "PENDING"
    },
    "canonical_identity_id": {
      "type": "string",
      "description": "Canonical chain identity id after an exceptional admin merge. Normally equal to chain_identity_id."
    },
    "recovery_count": {
      "type": "integer",
      "default": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_reconciled_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure_code": {
      "type": "string",
      "maxLength": 120,
      "description": "Non-sensitive machine-readable provisioning/reconciliation failure code."
    }
  },
  "required": [
    "user_id",
    "chain_identity_id",
    "network",
    "signer_version",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}