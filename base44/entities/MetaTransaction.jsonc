{
  "name": "MetaTransaction",
  "type": "object",
  "title": "MetaTransaction",
  "description": "DEPRECATED / QUARANTINED legacy Polygon/PulseChain meta-transaction relay design. It conflicts with the current SwapPulse zero-fee appchain architecture and is not part of V1. Retained only for audit/history; user access and creation are disabled.",
  "properties": {
    "user_did": {
      "type": "string",
      "description": "AT Protocol DID of the user who signed the meta-transaction"
    },
    "user_address": {
      "type": "string",
      "description": "Wallet address of the signing user"
    },
    "target_contract": {
      "type": "string",
      "description": "Target contract address for the meta-transaction call"
    },
    "function_name": {
      "type": "string",
      "description": "Name of the function to execute on the target contract"
    },
    "args": {
      "type": "object",
      "additionalProperties": true,
      "description": "Encoded function arguments (ABI-encoded). For PulseChain gasless transfers: { data, token, from, to, amount }."
    },
    "signature": {
      "type": "string",
      "description": "User's EIP-712 signature over the meta-transaction typed data"
    },
    "nonce": {
      "type": "integer",
      "default": 0,
      "description": "User's nonce at the time of signing (replay protection)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "processed",
        "failed"
      ],
      "default": "pending",
      "description": "Processing status: pending (queued), processing (relayer picked up), processed (on-chain tx confirmed), failed (error)"
    },
    "chain": {
      "type": "string",
      "enum": [
        "polygon",
        "pulse"
      ],
      "default": "polygon",
      "description": "Which chain's relayer processes this meta-transaction: 'polygon' (MetaTransactionRelay on Polygon) or 'pulse' (PulseGaslessRelay on PulseChain)"
    },
    "tx_hash": {
      "type": "string",
      "description": "On-chain transaction hash once the meta-transaction is processed"
    },
    "error": {
      "type": "string",
      "description": "Error message if processing failed"
    },
    "gas_cost_wei": {
      "type": "string",
      "default": "0",
      "description": "Gas cost paid by the relayer for this meta-transaction (in wei)"
    },
    "relayer_fee_wei": {
      "type": "string",
      "default": "0",
      "description": "Relayer fee charged for processing this meta-transaction (in wei)"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the meta-transaction was processed on-chain"
    }
  },
  "required": [
    "user_did",
    "user_address",
    "target_contract",
    "function_name",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}