  "name": "Pulse Gas Replenish",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pulse_gas_replenish",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "replenish_gas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "replenish-pulse-gas",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Replenish relayer PLS",
            "description": "Swap collected $PULSE fees to native PLS via PulseX when the relayer gas balance is low"
          }
        }
      }
