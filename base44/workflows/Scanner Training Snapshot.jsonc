{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "scanner_training_snapshot",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "build_snapshot": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "build-training-snapshot",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Build training snapshot",
            "description": "Export accepted corrections into a versioned training-dataset snapshot for offline retraining"
          }
        }
      }
    ]
  },
  "name": "Scanner Training Snapshot",
  "description": "Weekly export of accepted scanner corrections into a versioned, downloadable training-dataset snapshot for offline model retraining",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * 1",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}