{
  "trigger": {
    "condition": "${ false }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Post"
    }
  },
  "description": "SECURITY HOLD: automatic AI moderation trigger suspended until internal function calls have a platform-verifiable authentication mechanism.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ai_moderation_posts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "moderate_post": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ai-moderation",
            "args": {
              "content_type": "post",
              "content_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "AI moderate new post",
            "description": "Classify and apply tiered moderation actions"
          }
        }
      }
    ]
  },
  "name": "AI Moderation - Posts"
}