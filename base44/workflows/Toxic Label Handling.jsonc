{
  "name": "Toxic Label Handling",
  "description": "SECURITY HOLD: AI-assisted toxic-label follow-up is disabled. Account strikes and restrictions require an explicit human moderation decision and are never applied by an LLM-triggered workflow.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ModerationLabel",
      "events": [
        "create"
      ]
    },
    "condition": "${ false }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "toxic_label_handling",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "handle_toxic": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "handle-toxic-label",
            "args": {
              "subject_uri": "${ .trigger.data.subject_uri }",
              "labeler_did": "${ .trigger.data.labeler_did }",
              "note": "${ .trigger.data.note }",
              "label_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}