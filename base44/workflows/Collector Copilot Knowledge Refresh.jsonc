{
  "name": "Collector Copilot Knowledge Refresh",
  "description": "Checks a fixed allowlist of SwapPulse GitHub and GitBook source files each day. Changed content is quarantined for administrator review and is never published to the Collector Copilot automatically.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "15 5 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "collector_copilot_knowledge_refresh",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_project_knowledge": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "refresh-agent-knowledge",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check approved project sources",
            "description": "Fetch fixed source paths and queue changed snapshots for administrator review without publishing them"
          }
        }
      }
    ]
  }
}