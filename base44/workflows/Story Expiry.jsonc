{
  "description": "Deletes expired stories every hour to honour the 24h ephemeral window.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "story_expiry",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "expire": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expireStories"
          },
          "then": "end",
          "x-base44": {
            "title": "Delete expired stories",
            "description": "Removes stories past their 24h window"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Story Expiry"
}