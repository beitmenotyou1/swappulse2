{
  "name": "Wishlist Alerts",
  "description": "Checks saved searches every hour and notifies collectors when a wished card hits their target price or appears in an open trade",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "wishlist_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkWishlistAlerts"
          },
          "then": "end",
          "x-base44": {
            "title": "Check wishlist alerts",
            "description": "Notify matched collectors"
          }
        }
      }
    ]
  }
}