{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "firehose_ingestion",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "ingest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "firehose-ingest",
            "args": {}
          },
          "then": "reconcile",
          "x-base44": {
            "title": "Ingest from Firehose",
            "description": "Poll PDS/AppView for remote SwapPulse records (creates/updates/deletes) and ingest into local DB"
          }
        }
      },
      {
        "reconcile": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "outbound-reconcile",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Outbound Reconcile",
            "description": "Push locally-changed bridged records to the PDS, reconciling drift"
          }
        }
      }
    ]
  },
  "description": "Scheduled bidirectional sync \u2014 every 5 minutes (the platform minimum) ingests remote SwapPulse records (creates/updates/deletes) from the PDS/AppView into the local DB, then pushes locally-changed bridged records back to the PDS to reconcile drift.",
  "name": "Firehose Ingestion"
}