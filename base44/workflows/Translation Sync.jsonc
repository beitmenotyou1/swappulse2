{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "translation_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_translations": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sync-translations",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync pending translations",
            "description": "Processes pending TranslationOverride records by calling InvokeLLM to translate English source values into all nine supported languages"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Translation Sync",
  "description": "Daily at 3 AM \u2014 processes pending TranslationOverride records by calling InvokeLLM to translate English source values into all nine supported languages, filling gaps in the static translations.js file."
}