{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "TradeListing"
    }
  },
  "description": "Runs AI moderation analysis on new trade listings to detect scam language and misgrading",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ai_moderation_listings",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "moderate_listing": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ai-moderation",
            "args": {
              "content_type": "trade_listing",
              "content_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "AI moderate new trade listing",
            "description": "Detect scam language and misgrading in listing notes"
          }
        }
      }
    ]
  },
  "name": "AI Moderation - Trade Listings"
}