{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "checkout_expiry_cleanup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "expire_checkouts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expire-pending-checkouts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Revert expired pending checkouts",
            "description": "Checks Stripe session status for pending marketplace listings and reverts expired, unpaid sessions back to active"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Checkout Expiry Cleanup",
  "description": "Every 30 minutes, checks Stripe session status for pending marketplace listings and reverts expired, unpaid sessions back to active so abandoned checkouts don't lock up listings for 24 hours."
}