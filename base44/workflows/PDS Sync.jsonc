{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pds_sync",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sync-from-pds",
            "args": {}
          },
          "then": "push_profiles",
          "x-base44": {
            "title": "Sync from PDS",
            "description": "Poll PDS for deletions and updates"
          }
        }
      },
      {
        "push_profiles": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sync-profile-records",
            "args": {
              "adminBackfill": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Push profiles to PDS",
            "description": "Sync local profile updates (display name, avatar, bio) to the AT Protocol PDS so Bluesky reflects current SwapPulse data"
          }
        }
      }
    ]
  },
  "description": "Scheduled bidirectional sync with the AT Protocol PDS \u2014 pulls inbound deletions/updates and pushes outbound profile updates every 5 minutes.",
  "name": "PDS Sync"
}