{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pds_sync",
      "version": "1.4",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sync-from-pds",
            "args": {}
          },
          "then": "push_profiles",
          "x-base44": {
            "title": "Sync from PDS",
            "description": "Poll PDS for deletions and updates"
          }
        }
      },
      {
        "push_profiles": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sync-profile-records",
            "args": {
              "adminBackfill": true
            }
          },
          "then": "retry_handles",
          "x-base44": {
            "title": "Push profiles to PDS",
            "description": "Sync local profile updates (display name, avatar, bio, banner) to the AT Protocol PDS so Bluesky reflects current SwapPulse data. Paginates through all migrated users."
          }
        }
      },
      {
        "retry_handles": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "retry-pending-handles",
            "args": {}
          },
          "then": "sync_post_edits",
          "x-base44": {
            "title": "Retry pending handle updates",
            "description": "Retry handle updates to username.swappulse.org or custom domain for migrated users whose initial update failed because DNS wasn't ready yet."
          }
        }
      },
      {
        "sync_post_edits": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sync-post-edits",
            "args": {}
          },
          "then": "post_backfill_continue",
          "x-base44": {
            "title": "Push post edits to PDS",
            "description": "Detect locally-edited bridged posts and push the updated text to the PDS via putRecord so post edits on SwapPulse are reflected on Bluesky."
          }
        }
      },
      {
        "post_backfill_continue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backfill-author-posts",
            "args": {
              "continue": true
            }
          },
          "then": "likes_backfill_continue",
          "x-base44": {
            "title": "Continue post backfill",
            "description": "Continue backfilling historical posts for any migrated user whose post_backfill_complete is still false. Processes one page per user per 5-minute cycle until all histories are fully imported."
          }
        }
      },
      {
        "likes_backfill_continue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backfill-likes",
            "args": {
              "continue": true
            }
          },
          "then": "reposts_backfill_continue",
          "x-base44": {
            "title": "Continue likes backfill",
            "description": "Continue backfilling historical likes (app.bsky.feed.like) for migrated users whose likes_backfill_complete is still false. Processes one page per user per 5-minute cycle."
          }
        }
      },
      {
        "reposts_backfill_continue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backfill-reposts",
            "args": {
              "continue": true
            }
          },
          "then": "notifications_backfill_continue",
          "x-base44": {
            "title": "Continue reposts backfill",
            "description": "Continue backfilling historical reposts (app.bsky.feed.repost) for migrated users whose reposts_backfill_complete is still false. Processes one page per user per 5-minute cycle."
          }
        }
      },
      {
        "notifications_backfill_continue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "import-notification-snapshot",
            "args": {
              "continue": true
            }
          },
          "then": "lists_backfill_continue",
          "x-base44": {
            "title": "Continue notifications backfill",
            "description": "Continue backfilling the full notification history (app.bsky.notification.listNotifications) for migrated users whose notifications_backfill_complete is still false. Processes one page per user per 5-minute cycle."
          }
        }
      },
      {
        "lists_backfill_continue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backfill-lists",
            "args": {
              "continue": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Continue lists backfill",
            "description": "Continue backfilling Bluesky lists (app.bsky.graph.list, listitem, starterpack) for migrated users whose lists_backfill_complete is still false. Processes one page per user per 5-minute cycle across the lists \u2192 listitems \u2192 starterpacks phases."
          }
        }
      }
    ]
  },
  "description": "Scheduled bidirectional sync with the AT Protocol PDS \u2014 pulls inbound deletions/updates, pushes outbound profile updates, retries pending handle updates, pushes post edits, and continues all backfills (posts, likes, reposts, notifications, lists) for incomplete histories every 5 minutes.",
  "name": "PDS Sync"
}