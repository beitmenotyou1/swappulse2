{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_feature_promo",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "post_feature_promo": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "post-promo",
            "args": {
              "promoType": "feature"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Publish daily feature promo",
            "description": "Publishes a reviewed SwapPulse feature promotion through the hardened AT Protocol delivery path"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "15 10 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Feature Promo",
  "description": "Publishes one multilingual SwapPulse feature promotion daily through the same account-bound, audited AT Protocol path as the primary promotion workflow."
}