{
  "name": "Pulse Chain Indexer",
  "description": "Every 5 minutes, indexes new PulseChain blocks and transactions into PulseBlock / PulseTransaction entities so the explorer UI can browse and search them. Reads the PulseIndexerCursor, fetches new blocks via batched JSON-RPC, stores block + tx records, and advances the cursor.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pulse_chain_indexer",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "index_blocks": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pulse-indexer",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Index PulseChain blocks",
            "description": "Fetches new blocks + transactions from PULSE_RPC_URL and stores them"
          }
        }
      }
    ]
  }
}