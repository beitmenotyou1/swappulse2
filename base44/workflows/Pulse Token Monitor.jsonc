{
  "name": "Pulse Token Monitor",
  "description": "Every 5 minutes, reads $PULSE ERC-20 token stats via Etherscan (holders, top holders, price) + on-chain RPC (supply, whale transfers) and emails admins on whale transfers (>1% of supply), top-10 holder concentration >50%, or price drift >25% from the $0.001 target. Alerts are throttled (whales 1/hour, concentration & price 1/24h).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pulse_token_monitor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_token": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "get-pulse-token-stats",
            "args": {
              "alert": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Check $PULSE token stats",
            "description": "Reads $PULSE token stats via Etherscan + on-chain RPC and alerts admins on whale moves, concentration, or price drift"
          }
        }
      }
    ]
  }
}