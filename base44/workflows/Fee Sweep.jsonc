{
  "name": "Fee Sweep",
  "description": "Every 5 minutes, sweeps accumulated unswept fee USDC to the platform fee wallet on Polygon. Swaps POL for USDC via the Velora DEX if the platform wallet lacks sufficient USDC. Gas is paid in POL from the platform wallet.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "fee_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sweep": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sweep-fees",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sweep pending fees",
            "description": "Sends accumulated USDC fees to the platform fee wallet on Polygon"
          }
        }
      }
    ]
  }
}