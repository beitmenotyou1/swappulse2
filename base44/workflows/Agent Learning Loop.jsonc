{
  "name": "Agent Learning Loop",
  "description": "Processes agent feedback daily into inactive, safety-screened candidates that require administrator approval before any agent may use them",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "agent_learning_loop",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_feedback": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processAgentFeedback"
          },
          "then": "end",
          "x-base44": {
            "title": "Process agent feedback",
            "description": "Analyse feedback and quarantine improvement candidates for administrator review"
          }
        }
      }
    ]
  }
}