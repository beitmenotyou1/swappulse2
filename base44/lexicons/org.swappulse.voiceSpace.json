{
  "lexicon": 1,
  "id": "org.swappulse.voiceSpace",
  "revision": 2,
  "description": "A live audio space. Two modes: 'external' (manual Go Live pointing at an external stream URL) and 'in_platform' (a true in-platform audio stage using a WebRTC peer mesh). Mirrored to AT Protocol so live spaces are discoverable across instances.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A live audio space declaration.",
      "record": {
        "type": "object",
        "required": ["title", "status", "createdAt"],
        "properties": {
          "title": { "type": "string", "maxLength": 120, "description": "Space title (5-120 chars)" },
          "description": { "type": "string", "maxLength": 1000 },
          "spaceMode": { "type": "string", "knownValues": ["external", "in_platform"], "description": "external = external stream URL; in_platform = in-platform WebRTC audio stage" },
          "status": { "type": "string", "knownValues": ["scheduled", "live", "ended", "cancelled"], "description": "Lifecycle state" },
          "streamUrl": { "type": "string", "format": "uri", "description": "External stream URL (external mode only)" },
          "platform": { "type": "string", "knownValues": ["twitch", "youtube", "kick", "facebook_gaming", "rumble", "custom", "other"], "description": "Streaming platform (external mode only)" },
          "plannedDurationMinutes": { "type": "integer", "minimum": 15, "maximum": 480, "description": "Planned duration in minutes" },
          "autoEndAt": { "type": "string", "format": "datetime", "description": "Calculated end time = startedAt + plannedDurationMinutes" },
          "startedAt": { "type": "string", "format": "datetime", "description": "When the space went live" },
          "endedAt": { "type": "string", "format": "datetime", "description": "When the space ended or was cancelled" },
          "viewerCountEstimate": { "type": "integer", "description": "Optional approximate viewer count" },
          "coHostDids": { "type": "array", "items": { "type": "string", "format": "did" }, "maxLength": 3, "description": "AT Protocol DIDs of co-hosts" },
          "topicTags": { "type": "array", "items": { "type": "string", "maxLength": 30 }, "maxLength": 5 },
          "cardUrisDiscussed": { "type": "array", "items": { "type": "string" }, "maxLength": 20, "description": "Cards referenced during the space" },
          "recordingEnabled": { "type": "boolean", "description": "True while the host is recording the in-platform stage audio" },
          "recordingAvailable": { "type": "boolean", "description": "Whether a recording is available post-space" },
          "podcastEpisodeUri": { "type": "string", "format": "at-uri", "description": "at:// URI of podcast episode if converted from a recording" },
          "hostDid": { "type": "string", "format": "did", "description": "AT Protocol DID of the host" },
          "hostName": { "type": "string" },
          "hostHandle": { "type": "string" },
          "hostAvatar": { "type": "string", "format": "uri" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}